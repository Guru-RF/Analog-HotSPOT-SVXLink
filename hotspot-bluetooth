#!/usr/bin/env python3
"""
HotSpot Bluetooth DTMF Service

BLE GATT server that accepts DTMF commands over a writable characteristic
and forwards them to SVXLink via /usr/sbin/hotspot_dtmf (which pipes the
value into `nc -N 127.0.0.1 10000`).

Protocol for the mobile app (iOS CoreBluetooth / Android BluetoothGatt):

  Advertised service UUID : 6b1d6a10-c50f-4d86-a7f3-7f2a3a1b2c3d
  DTMF write characteristic : 6b1d6a11-c50f-4d86-a7f3-7f2a3a1b2c3d
      - properties: write, write-without-response
      - payload:    ASCII DTMF string, e.g. "91" or "D#"
      - allowed:    0-9, A-D, *, #
      - max length: 64 bytes
  Status characteristic     : 6b1d6a12-c50f-4d86-a7f3-7f2a3a1b2c3d
      - properties: notify
      - payload:    UTF-8 status string ("ok ..." / "err ...")
  Command characteristic    : 6b1d6a13-c50f-4d86-a7f3-7f2a3a1b2c3d
      - properties: write, write-without-response
      - payload:    one of a fixed set of ASCII commands:
                      reboot, poweroff,
                      svxlink-start, svxlink-stop, svxlink-restart,
                      4g-enable, 4g-disable
      - result:     notified on the status characteristic
  Feed characteristic       : 6b1d6a14-c50f-4d86-a7f3-7f2a3a1b2c3d
      - properties: notify
      - payload:    compact JSON snapshot of hotspot state built by tailing
                    /var/log/svxlink: ip, callsign (cs), frequency (fq),
                    talkgroup (tg), current talker (tk), last talker (ltk),
                    tx / rx flags. Clients should negotiate MTU >= 200.

The server advertises as the device hostname and does not require pairing —
the characteristics have no encrypt-* flags, so iOS/macOS (Web Bluetooth)
connect without any prompt. Android's BLE stack, however, eagerly initiates
bonding on first connect regardless of the peripheral's security flags; if
BlueZ has no pairing agent registered it rejects the bond request and
Android falls into a reconnect loop. To handle that, this service also
registers a NoInputNoOutput "Just Works" agent that auto-accepts bonds and
trusts the remote — the first Android connect pairs silently, subsequent
reconnects skip the handshake. Add encrypt-* flags only if you actually
want to *require* bonded clients.
"""

import json
import logging
import os
import re
import socket
import subprocess
import sys
import threading
import time

import dbus
import dbus.exceptions
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib


BLUEZ_SERVICE_NAME = "org.bluez"
DBUS_OM_IFACE = "org.freedesktop.DBus.ObjectManager"
DBUS_PROP_IFACE = "org.freedesktop.DBus.Properties"

GATT_MANAGER_IFACE = "org.bluez.GattManager1"
GATT_SERVICE_IFACE = "org.bluez.GattService1"
GATT_CHRC_IFACE = "org.bluez.GattCharacteristic1"

LE_ADVERTISING_MANAGER_IFACE = "org.bluez.LEAdvertisingManager1"
LE_ADVERTISEMENT_IFACE = "org.bluez.LEAdvertisement1"

ADAPTER_IFACE = "org.bluez.Adapter1"
DEVICE_IFACE = "org.bluez.Device1"

AGENT_MANAGER_IFACE = "org.bluez.AgentManager1"
AGENT_IFACE = "org.bluez.Agent1"
AGENT_PATH = "/org/guru_rf/hotspot/agent"
AGENT_CAPABILITY = "NoInputNoOutput"

DTMF_SVC_UUID = "6b1d6a10-c50f-4d86-a7f3-7f2a3a1b2c3d"
DTMF_WRITE_UUID = "6b1d6a11-c50f-4d86-a7f3-7f2a3a1b2c3d"
DTMF_STATUS_UUID = "6b1d6a12-c50f-4d86-a7f3-7f2a3a1b2c3d"
DTMF_COMMAND_UUID = "6b1d6a13-c50f-4d86-a7f3-7f2a3a1b2c3d"
DTMF_FEED_UUID = "6b1d6a14-c50f-4d86-a7f3-7f2a3a1b2c3d"

DTMF_HELPER = "/usr/sbin/hotspot_dtmf"
ALLOWED_DTMF_CHARS = set("0123456789ABCDabcd*#")
MAX_PAYLOAD_BYTES = 64

# State feed sources (mirrors svxoled.py so hotspots without an OLED still work).
SVXLINK_LOGFILE = "/var/log/svxlink"
SVXLINK_CONF = "/etc/svxlink/svxlink.conf"
HOTSPOT_SCRIPT = "/usr/sbin/hotspot"
FEED_IP_REFRESH = 30.0       # seconds
FEED_HEARTBEAT = 3.0         # seconds between "unchanged" pushes
FEED_SIGNAL_REFRESH = 30.0   # seconds between qmicli signal polls
QMICLI_DEVICE = "/dev/cdc-wdm0"

# Whitelisted commands. Each entry: (fire_and_forget, argv).
# "fire_and_forget" commands notify "ok <name>" immediately and exec in the
# background — used for reboot/poweroff so the BLE notify flushes before the
# kernel tears us down.
COMMANDS = {
    "reboot":          (True,  ["sh", "-c", "sleep 1; systemctl reboot"]),
    "poweroff":        (True,  ["sh", "-c", "sleep 1; systemctl poweroff"]),
    "svxlink-start":   (False, ["systemctl", "start", "svxlink"]),
    "svxlink-stop":    (False, ["systemctl", "stop", "svxlink"]),
    "svxlink-restart": (False, ["systemctl", "restart", "svxlink"]),
    "4g-enable":       (False, ["systemctl", "start", "--no-block", "hotspot-4g"]),
    "4g-disable":      (False, ["sh", "-c",
                                "systemctl stop hotspot-4g; "
                                "ip link set wlan0 up 2>/dev/null || true"]),
}

log = logging.getLogger("hotspot-bluetooth")


class InvalidArgsException(dbus.exceptions.DBusException):
    _dbus_error_name = "org.freedesktop.DBus.Error.InvalidArgs"


class NotSupportedException(dbus.exceptions.DBusException):
    _dbus_error_name = "org.bluez.Error.NotSupported"


class FailedException(dbus.exceptions.DBusException):
    _dbus_error_name = "org.bluez.Error.Failed"


class RejectedException(dbus.exceptions.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"


class JustWorksAgent(dbus.service.Object):
    """NoInputNoOutput pairing agent.

    Auto-accepts every prompt BlueZ throws at us. This is the "Just Works"
    SSP model — fine for a hotspot-on-your-desk scenario, where any client
    in radio range is already trusted by the owner. On pairing, the remote
    device is marked Trusted so future reconnects skip authorization.
    """

    def __init__(self, bus):
        dbus.service.Object.__init__(self, bus, AGENT_PATH)
        self._bus = bus

    def _trust_device(self, device_path):
        try:
            props = dbus.Interface(
                self._bus.get_object(BLUEZ_SERVICE_NAME, device_path),
                DBUS_PROP_IFACE,
            )
            props.Set(DEVICE_IFACE, "Trusted", dbus.Boolean(True))
        except Exception as e:
            log.warning("Failed to mark %s trusted: %s", device_path, e)

    @dbus.service.method(AGENT_IFACE, in_signature="", out_signature="")
    def Release(self):
        log.info("Pairing agent released")

    @dbus.service.method(AGENT_IFACE, in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        log.info("AuthorizeService %s %s — accepted", device, uuid)
        self._trust_device(device)

    @dbus.service.method(AGENT_IFACE, in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        log.info("RequestPinCode %s — returning 0000", device)
        self._trust_device(device)
        return "0000"

    @dbus.service.method(AGENT_IFACE, in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        log.info("RequestPasskey %s — returning 0", device)
        self._trust_device(device)
        return dbus.UInt32(0)

    @dbus.service.method(AGENT_IFACE, in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        log.info("DisplayPasskey %s %06u (entered %u)", device, passkey, entered)

    @dbus.service.method(AGENT_IFACE, in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        log.info("DisplayPinCode %s %s", device, pincode)

    @dbus.service.method(AGENT_IFACE, in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        log.info("RequestConfirmation %s %06u — confirmed", device, passkey)
        self._trust_device(device)

    @dbus.service.method(AGENT_IFACE, in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        log.info("RequestAuthorization %s — authorized", device)
        self._trust_device(device)

    @dbus.service.method(AGENT_IFACE, in_signature="", out_signature="")
    def Cancel(self):
        log.info("Pairing cancelled by remote")


class Application(dbus.service.Object):
    PATH = "/org/guru_rf/hotspot"

    def __init__(self, bus):
        self.path = self.PATH
        self.services = []
        dbus.service.Object.__init__(self, bus, self.path)

    def get_path(self):
        return dbus.ObjectPath(self.path)

    def add_service(self, service):
        self.services.append(service)

    @dbus.service.method(DBUS_OM_IFACE, out_signature="a{oa{sa{sv}}}")
    def GetManagedObjects(self):
        response = {}
        for svc in self.services:
            response[svc.get_path()] = svc.get_properties()
            for chrc in svc.characteristics:
                response[chrc.get_path()] = chrc.get_properties()
        return response


class Service(dbus.service.Object):
    PATH_BASE = "/org/guru_rf/hotspot/service"

    def __init__(self, bus, index, uuid, primary):
        self.path = f"{self.PATH_BASE}{index}"
        self.bus = bus
        self.uuid = uuid
        self.primary = primary
        self.characteristics = []
        dbus.service.Object.__init__(self, bus, self.path)

    def get_properties(self):
        return {
            GATT_SERVICE_IFACE: {
                "UUID": self.uuid,
                "Primary": self.primary,
                "Characteristics": dbus.Array(
                    [c.get_path() for c in self.characteristics], signature="o"
                ),
            }
        }

    def get_path(self):
        return dbus.ObjectPath(self.path)

    def add_characteristic(self, characteristic):
        self.characteristics.append(characteristic)

    @dbus.service.method(DBUS_PROP_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface):
        if interface != GATT_SERVICE_IFACE:
            raise InvalidArgsException()
        return self.get_properties()[GATT_SERVICE_IFACE]


class Characteristic(dbus.service.Object):
    def __init__(self, bus, index, uuid, flags, service):
        self.path = f"{service.path}/char{index}"
        self.bus = bus
        self.uuid = uuid
        self.service = service
        self.flags = flags
        dbus.service.Object.__init__(self, bus, self.path)

    def get_properties(self):
        return {
            GATT_CHRC_IFACE: {
                "Service": self.service.get_path(),
                "UUID": self.uuid,
                "Flags": self.flags,
            }
        }

    def get_path(self):
        return dbus.ObjectPath(self.path)

    @dbus.service.method(DBUS_PROP_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface):
        if interface != GATT_CHRC_IFACE:
            raise InvalidArgsException()
        return self.get_properties()[GATT_CHRC_IFACE]

    @dbus.service.method(GATT_CHRC_IFACE, in_signature="a{sv}", out_signature="ay")
    def ReadValue(self, options):
        raise NotSupportedException()

    @dbus.service.method(GATT_CHRC_IFACE, in_signature="aya{sv}")
    def WriteValue(self, value, options):
        raise NotSupportedException()

    @dbus.service.method(GATT_CHRC_IFACE)
    def StartNotify(self):
        raise NotSupportedException()

    @dbus.service.method(GATT_CHRC_IFACE)
    def StopNotify(self):
        raise NotSupportedException()

    @dbus.service.signal(DBUS_PROP_IFACE, signature="sa{sv}as")
    def PropertiesChanged(self, interface, changed, invalidated):
        pass


class StatusCharacteristic(Characteristic):
    def __init__(self, bus, index, service):
        super().__init__(bus, index, DTMF_STATUS_UUID, ["notify"], service)
        self.notifying = False

    def notify_text(self, text):
        if not self.notifying:
            return
        data = dbus.Array(
            [dbus.Byte(b) for b in text.encode("utf-8")[:512]], signature="y"
        )
        self.PropertiesChanged(GATT_CHRC_IFACE, {"Value": data}, [])

    @dbus.service.method(GATT_CHRC_IFACE)
    def StartNotify(self):
        self.notifying = True
        log.info("Status notifications started")

    @dbus.service.method(GATT_CHRC_IFACE)
    def StopNotify(self):
        self.notifying = False
        log.info("Status notifications stopped")


class DtmfWriteCharacteristic(Characteristic):
    def __init__(self, bus, index, service, status_char):
        super().__init__(
            bus,
            index,
            DTMF_WRITE_UUID,
            ["write", "write-without-response"],
            service,
        )
        self.status_char = status_char

    @dbus.service.method(GATT_CHRC_IFACE, in_signature="aya{sv}")
    def WriteValue(self, value, options):
        raw = bytes(value)
        if len(raw) > MAX_PAYLOAD_BYTES:
            log.warning("Oversize DTMF write (%d bytes), rejecting", len(raw))
            raise FailedException("payload too long")

        payload = raw.decode("utf-8", errors="replace").strip()
        if not payload:
            log.warning("Empty DTMF write, ignoring")
            return

        if not set(payload).issubset(ALLOWED_DTMF_CHARS):
            log.warning("Rejected DTMF payload with disallowed chars: %r", payload)
            raise FailedException("invalid DTMF characters")

        log.info("DTMF -> %s", payload)
        run_async(self.status_char, payload, [DTMF_HELPER, payload], timeout=5)


class CommandCharacteristic(Characteristic):
    def __init__(self, bus, index, service, status_char):
        super().__init__(
            bus,
            index,
            DTMF_COMMAND_UUID,
            ["write", "write-without-response"],
            service,
        )
        self.status_char = status_char

    @dbus.service.method(GATT_CHRC_IFACE, in_signature="aya{sv}")
    def WriteValue(self, value, options):
        raw = bytes(value)
        if len(raw) > MAX_PAYLOAD_BYTES:
            log.warning("Oversize command write (%d bytes), rejecting", len(raw))
            raise FailedException("payload too long")

        cmd = raw.decode("utf-8", errors="replace").strip().lower()
        if not cmd:
            log.warning("Empty command write, ignoring")
            return

        entry = COMMANDS.get(cmd)
        if not entry:
            log.warning("Rejected unknown command: %r", cmd)
            self.status_char.notify_text(f"err unknown {cmd}")
            raise FailedException("unknown command")

        fire_and_forget, argv = entry
        log.info("command -> %s", cmd)

        if fire_and_forget:
            self.status_char.notify_text(f"ok {cmd}")
            subprocess.Popen(
                argv,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                close_fds=True,
            )
            return

        run_async(self.status_char, cmd, argv, timeout=20)


class FeedCharacteristic(Characteristic):
    """Notify-only state feed; mirrors svxoled's view of the hotspot."""

    def __init__(self, bus, index, service):
        super().__init__(bus, index, DTMF_FEED_UUID, ["notify"], service)
        self.notifying = False
        self.last_payload = None

    def push(self, data):
        # Runs on the GLib main thread (scheduled by StateFeed via idle_add).
        self.last_payload = data
        if self.notifying:
            self._emit(data)
        return False

    def _emit(self, data):
        arr = dbus.Array([dbus.Byte(b) for b in data[:512]], signature="y")
        self.PropertiesChanged(GATT_CHRC_IFACE, {"Value": arr}, [])

    @dbus.service.method(GATT_CHRC_IFACE)
    def StartNotify(self):
        self.notifying = True
        log.info("Feed notifications started")
        if self.last_payload:
            self._emit(self.last_payload)

    @dbus.service.method(GATT_CHRC_IFACE)
    def StopNotify(self):
        self.notifying = False
        log.info("Feed notifications stopped")


class StateFeed:
    """Tails /var/log/svxlink, builds compact JSON, pushes to FeedCharacteristic.

    Parsing rules kept in sync with svxoled.py so clients see the same view.
    """

    def __init__(self, feed_char):
        self.feed_char = feed_char
        self.state = {
            "ip": "",
            "cs": "",
            "fq": "",
            "tg": "",
            "tk": "",
            "ltk": "",
            "tx": 0,
            "rx": 0,
            "sg": "",
        }
        self._last_payload = None
        self._last_sent = 0.0
        self._last_ip_refresh = 0.0
        self._last_signal_refresh = 0.0

    def start(self):
        threading.Thread(target=self._run, daemon=True).start()

    def _read_callsign(self):
        try:
            with open(SVXLINK_CONF, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    m = re.match(r'^\s*CALLSIGN\s*=\s*"?([^"\s]+)"?\s*$', line)
                    if m:
                        return m.group(1).strip()
        except Exception:
            pass
        return ""

    def _read_frequency(self):
        try:
            with open(HOTSPOT_SCRIPT, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    if "--frequency" in line:
                        m = re.search(r'--frequency\s+([0-9]+(?:\.[0-9]+)?)', line)
                        if m:
                            return m.group(1)
        except Exception:
            pass
        return ""

    def _read_ip(self):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.settimeout(1.0)
            s.connect(("8.8.8.8", 80))
            ip = s.getsockname()[0]
            s.close()
            return ip
        except Exception:
            return ""

    def _refresh_signal(self):
        # The 4G stack masks ModemManager and drives the modem with qmicli, so
        # mmcli would always see "no modem". The -p flag routes through
        # qmi-proxy, which serializes access with hotspot-4g (it holds a CID
        # via --client-no-release-cid). Without -p we'd collide.
        if not os.path.exists(QMICLI_DEVICE):
            return ""
        try:
            r = subprocess.run(
                ["qmicli", "-p", "-d", QMICLI_DEVICE,
                 "--nas-get-signal-strength"],
                capture_output=True, text=True, timeout=5,
            )
        except (FileNotFoundError, subprocess.TimeoutExpired, Exception):
            return ""
        if r.returncode != 0:
            return ""
        # Output format (LTE example):
        #   Current:
        #           Network 'lte': '-78 dBm'
        #   RSSI:
        #           Network 'lte': '-78 dBm'
        # Prefer Current → RSSI → RSRP. Current/RSSI match the "bars" mental
        # model; RSRP runs ~30 dB lower on LTE and would make a fine link
        # look poor.
        for key in ("Current", "RSSI", "RSRP"):
            m = re.search(
                rf"\b{key}:\s*\n\s*Network\s+'[^']*':\s*'(-?\d+(?:\.\d+)?)\s*dBm'",
                r.stdout,
            )
            if m:
                return int(float(m.group(1)))
        return ""

    def _open_log(self, seek_end):
        f = open(SVXLINK_LOGFILE, "r", encoding="utf-8", errors="replace")
        f.seek(0, 2 if seek_end else 0)
        return f, os.fstat(f.fileno()).st_ino

    def _check_log_reopen(self, f, ino):
        try:
            st = os.stat(SVXLINK_LOGFILE)
        except FileNotFoundError:
            return f, ino
        except Exception:
            return f, ino
        try:
            cur = f.tell()
        except Exception:
            cur = 0
        if st.st_ino != ino:
            try:
                f.close()
            except Exception:
                pass
            try:
                return self._open_log(seek_end=False)
            except Exception:
                return f, ino
        if st.st_size < cur:
            try:
                f.seek(0, 0)
            except Exception:
                pass
        return f, ino

    def _parse_line(self, line):
        l = line.lower()
        if "rx1: the squelch is open" in l:
            self.state["rx"] = 1
        elif "rx1: the squelch is closed" in l:
            self.state["rx"] = 0

        if "selecting tg #" in l:
            m = re.search(r"tg\s*#(\d+)", l)
            if m:
                self.state["tg"] = m.group(1)

        if "talker start on tg #" in l:
            m = re.search(r"tg\s*#(\d+)", l)
            if m:
                self.state["tg"] = m.group(1)
            try:
                self.state["tk"] = line.rsplit(":", 1)[1].strip()
            except Exception:
                pass
        elif "talker stop on tg #" in l:
            if self.state["tk"]:
                self.state["ltk"] = self.state["tk"]
            self.state["tk"] = ""
        elif "turning the transmitter on" in l:
            self.state["tx"] = 1
        elif "turning the transmitter off" in l:
            self.state["tx"] = 0
            if self.state["tk"]:
                self.state["ltk"] = self.state["tk"]
            self.state["tk"] = ""

    def _maybe_push(self, now, force=False):
        payload = json.dumps(self.state, separators=(",", ":")).encode("utf-8")
        unchanged = payload == self._last_payload
        if not force and unchanged and (now - self._last_sent) < FEED_HEARTBEAT:
            return
        self._last_payload = payload
        self._last_sent = now
        GLib.idle_add(self.feed_char.push, payload)

    def _run(self):
        self.state["cs"] = self._read_callsign()
        self.state["fq"] = self._read_frequency()
        self.state["ip"] = self._read_ip()
        self.state["sg"] = self._refresh_signal()
        self._last_ip_refresh = time.monotonic()
        self._last_signal_refresh = self._last_ip_refresh

        f = None
        ino = None
        try:
            f, ino = self._open_log(seek_end=True)
        except Exception as e:
            log.warning("Cannot open %s yet: %s", SVXLINK_LOGFILE, e)

        self._maybe_push(time.monotonic(), force=True)

        while True:
            now = time.monotonic()

            if f is not None:
                try:
                    while True:
                        line = f.readline()
                        if not line:
                            break
                        self._parse_line(line)
                except Exception:
                    log.exception("log tail error")
                f, ino = self._check_log_reopen(f, ino)
            else:
                try:
                    f, ino = self._open_log(seek_end=True)
                except Exception:
                    pass

            if now - self._last_ip_refresh > FEED_IP_REFRESH:
                new_ip = self._read_ip()
                if new_ip:
                    self.state["ip"] = new_ip
                self._last_ip_refresh = now

            if now - self._last_signal_refresh > FEED_SIGNAL_REFRESH:
                self.state["sg"] = self._refresh_signal()
                self._last_signal_refresh = now

            self._maybe_push(now)
            time.sleep(0.1)


class HotspotDtmfService(Service):
    def __init__(self, bus, index):
        super().__init__(bus, index, DTMF_SVC_UUID, True)
        status = StatusCharacteristic(bus, 2, self)
        self.feed = FeedCharacteristic(bus, 3, self)
        write = DtmfWriteCharacteristic(bus, 0, self, status)
        command = CommandCharacteristic(bus, 1, self, status)
        self.add_characteristic(write)
        self.add_characteristic(command)
        self.add_characteristic(status)
        self.add_characteristic(self.feed)


class Advertisement(dbus.service.Object):
    PATH_BASE = "/org/guru_rf/hotspot/advertisement"

    def __init__(self, bus, index, local_name):
        self.path = f"{self.PATH_BASE}{index}"
        self.bus = bus
        self.ad_type = "peripheral"
        self.local_name = local_name
        dbus.service.Object.__init__(self, bus, self.path)

    def get_properties(self):
        return {
            LE_ADVERTISEMENT_IFACE: {
                "Type": self.ad_type,
                "ServiceUUIDs": dbus.Array([DTMF_SVC_UUID], signature="s"),
                "LocalName": dbus.String(self.local_name),
            }
        }

    def get_path(self):
        return dbus.ObjectPath(self.path)

    @dbus.service.method(DBUS_PROP_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface):
        if interface != LE_ADVERTISEMENT_IFACE:
            raise InvalidArgsException()
        return self.get_properties()[LE_ADVERTISEMENT_IFACE]

    @dbus.service.method(LE_ADVERTISEMENT_IFACE, in_signature="", out_signature="")
    def Release(self):
        log.info("Advertisement released: %s", self.path)


def wait_for_bluez(bus, timeout=60):
    import time
    deadline = time.monotonic() + timeout
    bus_obj = bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus")
    dbus_iface = dbus.Interface(bus_obj, "org.freedesktop.DBus")
    while time.monotonic() < deadline:
        try:
            if dbus_iface.NameHasOwner(BLUEZ_SERVICE_NAME):
                return True
        except dbus.exceptions.DBusException:
            pass
        log.info("waiting for bluez...")
        time.sleep(2)
    return False


def find_adapter(bus):
    remote_om = dbus.Interface(
        bus.get_object(BLUEZ_SERVICE_NAME, "/"), DBUS_OM_IFACE
    )
    for path, ifaces in remote_om.GetManagedObjects().items():
        if GATT_MANAGER_IFACE in ifaces and LE_ADVERTISING_MANAGER_IFACE in ifaces:
            return path
    return None


def power_on_adapter(bus, adapter_path):
    props = dbus.Interface(
        bus.get_object(BLUEZ_SERVICE_NAME, adapter_path), DBUS_PROP_IFACE
    )
    props.Set(ADAPTER_IFACE, "Powered", dbus.Boolean(True))
    # Let Android's eager-bonding stack succeed at pairing (see JustWorksAgent).
    # PairableTimeout=0 means "always pairable"; the adapter isn't BR/EDR-
    # discoverable (ControllerMode=le) so this only affects LE bonds.
    try:
        props.Set(ADAPTER_IFACE, "Pairable", dbus.Boolean(True))
        props.Set(ADAPTER_IFACE, "PairableTimeout", dbus.UInt32(0))
    except dbus.exceptions.DBusException as e:
        log.warning("Could not set Pairable on adapter: %s", e)


def register_agent(bus):
    agent = JustWorksAgent(bus)
    manager = dbus.Interface(
        bus.get_object(BLUEZ_SERVICE_NAME, "/org/bluez"), AGENT_MANAGER_IFACE
    )
    manager.RegisterAgent(AGENT_PATH, AGENT_CAPABILITY)
    manager.RequestDefaultAgent(AGENT_PATH)
    log.info("Registered %s pairing agent at %s", AGENT_CAPABILITY, AGENT_PATH)
    return agent


def local_name():
    try:
        return socket.gethostname()[:20]
    except Exception:
        return "hotspot"


def run_async(status_char, label, argv, timeout):
    """Run argv in a worker thread; notify status_char via the GLib main loop."""
    def worker():
        try:
            r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
            if r.returncode == 0:
                status = f"ok {label}"
            else:
                status = f"err {label} rc={r.returncode} {r.stderr.strip()}"
        except subprocess.TimeoutExpired:
            status = f"err {label} timeout"
            log.error("%s timed out", label)
        except Exception as e:
            status = f"err {label} {e!r}"
            log.exception("%s failed", label)
        GLib.idle_add(status_char.notify_text, status)

    threading.Thread(target=worker, daemon=True).start()


def main():
    logging.basicConfig(
        level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s"
    )

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()

    if not wait_for_bluez(bus):
        log.error(
            "bluez not available on D-Bus. Check: "
            "'systemctl status bluetooth' and 'hciconfig -a'"
        )
        sys.exit(1)

    adapter = find_adapter(bus)
    if not adapter:
        log.error(
            "No Bluetooth adapter with GATT + LE advertising support found. "
            "If you just removed dtoverlay=disable-bt, reboot first."
        )
        sys.exit(1)
    log.info("Using adapter: %s", adapter)
    power_on_adapter(bus, adapter)

    try:
        register_agent(bus)
    except dbus.exceptions.DBusException as e:
        log.warning(
            "Pairing agent registration failed (%s); Android clients that "
            "initiate bonding will reject-loop until this is resolved.", e
        )

    service_manager = dbus.Interface(
        bus.get_object(BLUEZ_SERVICE_NAME, adapter), GATT_MANAGER_IFACE
    )
    ad_manager = dbus.Interface(
        bus.get_object(BLUEZ_SERVICE_NAME, adapter), LE_ADVERTISING_MANAGER_IFACE
    )

    app = Application(bus)
    hotspot_service = HotspotDtmfService(bus, 0)
    app.add_service(hotspot_service)
    advertisement = Advertisement(bus, 0, local_name())

    StateFeed(hotspot_service.feed).start()

    mainloop = GLib.MainLoop()

    service_manager.RegisterApplication(
        app.get_path(),
        {},
        reply_handler=lambda: log.info("GATT application registered"),
        error_handler=lambda e: (log.error("RegisterApplication: %s", e), mainloop.quit()),
    )
    ad_manager.RegisterAdvertisement(
        advertisement.get_path(),
        {},
        reply_handler=lambda: log.info("Advertising as %s", advertisement.local_name),
        error_handler=lambda e: (log.error("RegisterAdvertisement: %s", e), mainloop.quit()),
    )

    try:
        mainloop.run()
    except KeyboardInterrupt:
        log.info("Shutting down")
    finally:
        try:
            ad_manager.UnregisterAdvertisement(advertisement.get_path())
        except Exception:
            pass
        try:
            service_manager.UnregisterApplication(app.get_path())
        except Exception:
            pass


if __name__ == "__main__":
    main()

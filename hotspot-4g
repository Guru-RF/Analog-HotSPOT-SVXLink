#!/bin/bash
set -euo pipefail

CONF="/etc/hotspot-4g.conf"

# defaults
APN="globaldata.iot"
IP_TYPE="4"
AUTH=""
APN_USER=""
APN_PASS=""

if [[ -f "$CONF" ]]; then
  # shellcheck disable=SC1090
  source "$CONF" || true
fi

ip link set wwan0 down
echo Y > /sys/class/net/wwan0/qmi/raw_ip

for _ in $(seq 1 600); do /usr/bin/test -c /dev/cdc-wdm0 && break; /bin/sleep 1; done
for _ in $(seq 1 600); do /usr/bin/qmicli -d /dev/cdc-wdm0 --nas-get-signal-strength && break; /bin/sleep 1; done

ip link set wwan0 up

# Build WDS start string; only include creds/auth when non-empty
WDS="apn='${APN}',ip-type=${IP_TYPE}"

if [[ -n "${AUTH}" ]]; then
  WDS="${WDS},auth=${AUTH}"
fi
if [[ -n "${APN_USER}" ]]; then
  WDS="${WDS},username='${APN_USER}'"
fi
if [[ -n "${APN_PASS}" ]]; then
  WDS="${WDS},password='${APN_PASS}'"
fi

qmicli -p -d /dev/cdc-wdm0 \
  --device-open-net='net-raw-ip|net-no-qos-header' \
  --wds-start-network="${WDS}" \
  --client-no-release-cid

udhcpc -q -f -i wwan0

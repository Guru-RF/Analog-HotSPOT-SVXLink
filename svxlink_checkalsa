#!/bin/bash
# ExecStartPre for svxlink.service / remotetrx.service.
#
# WM8960 (old boards): kicks the Waveshare userspace helper
# (/usr/bin/wm8960-soundcard) if present, waits for the card to
# enumerate, then applies /usr/sbin/hotspot_volume so the mixer
# state matches what hotspot-config generated.
#
# TLV320AIC3204 (REV 6+ boards): NOTHING to do here — exit 0.
# The audiosense-pi dtoverlay loads the in-tree snd-soc-tlv320aic32x4
# driver at boot with no userspace kick, alsactl restores mixer
# state, and hotspot-config / hotspot-tune-volume apply
# hotspot_volume directly (not via this ExecStartPre). Running the
# WM8960-shaped helper here would fail with "wm8960-soundcard: command
# not found" clutter in the journal and never touch the actual
# card.

CODEC=$(/usr/local/bin/hotspot-audio-detect 2>/dev/null || echo UNKNOWN)

case "$CODEC" in
  TLV320AIC3204)
    exit 0
    ;;
esac

# WM8960 (or UNKNOWN — assume WM8960 for backwards compat with old
# images that predate hotspot-audio-detect).
[ -x /usr/bin/wm8960-soundcard ] && /usr/bin/wm8960-soundcard >/dev/null 2>&1 || true

for i in $(seq 1 30); do
  if aplay -l 2>/dev/null | grep -qE '^card [0-9]'; then
    break
  fi
  echo "Waiting for sound driver ($i/30)"
  sleep 1
done

/usr/sbin/hotspot_volume

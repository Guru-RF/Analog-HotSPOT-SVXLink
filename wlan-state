#!/bin/bash
# /usr/sbin/wlan-state — centralised wlan0 up/down for the 4G stack.
#
# Used by disable-wlan.service, hotspot-4g (success path) and
# hotspot-4g-monitor (bring_wlan_{up,down}). Keeps the three call sites
# consistent and stops AccessPopup alongside the netdev so it doesn't
# pointlessly try to broadcast an AP while 4G is the active uplink.
#
# Historical note: an earlier revision tried to keep the netdev UP when
# BT was installed, under the (incorrect) theory that the BCM combo chip
# couldn't advertise BLE with wlan0 down. The real cause was a Synaptics
# firmware blob refusing MGMT_OP_ADD_EXT_ADV_DATA — fixed in
# hotspot-bluetooth by calling btmgmt's legacy add-adv directly. wlan0
# can safely go fully down even with BT installed; verified live.

set -u

action="${1:-}"

case "$action" in
  down)
    systemctl stop accesspopup.service 2>/dev/null || true
    ip link set wlan0 down 2>/dev/null || true
    ;;
  up)
    ip link set wlan0 up 2>/dev/null || true
    systemctl try-restart accesspopup.service 2>/dev/null || true
    ;;
  *)
    echo "usage: $0 {up|down}" >&2
    exit 2
    ;;
esac

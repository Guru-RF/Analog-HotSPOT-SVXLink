#!/bin/bash

TERM=xterm-256color

run() {
  exec=$1
  printf "\x1b[38;5;104m --> ${exec}\x1b[39m\n"
  eval ${exec}
}

say () {
  say=$1
  printf "\x1b[38;5;220m${say}\x1b[38;5;255m\n"
}

# SWITCH_MODE — DTMF or CTCSS — is inferred from the running config
# so this tool stays consistent with whatever the user picked in
# hotspot-config-online. Empty CTCSS_TO_TG ⇒ DTMF (SA818PRO always,
# or non-PRO chips whose user chose DTMF). In DTMF mode the sa818
# chip does the CTCSS decode + audio filtering in hardware and drives
# GPIO12; svxlink reads squelch off GPIO12 (SQL_DET=GPIOD) and leaves
# audio shaping to the chip (DEEMPHASIS=0/PREEMPHASIS=0). In CTCSS
# mode svxlink does software CTCSS decode with per-tone TG switching.
#
# Note: no separate PRO-chip marker is needed here — the DTMF-mode
# override block below applies identically to every chip variant since
# hotspot-config-online routes all DTMF-mode boxes through the chip's
# hardware CTCSS decoder + GPIO12.
OLDCTCSSMAPPING=$(grep '^CTCSS_TO_TG=' /etc/svxlink/svxlink.conf 2>/dev/null | head -n 1 | tr "=" "\n" | tail -n 1)
OLDTGS=$(grep '^MONITOR_TGS=' /etc/svxlink/svxlink.conf 2>/dev/null | head -n 1 | tr "=" "\n" | tail -n 1)
CALL=$(cat /etc/svxlink/svxlink.conf | grep CALL | head -n 1 | tr "=" "\n" | tail -n 1)
QSYTIMEOUT=$(cat /etc/svxlink/svxlink.conf | grep QSY_PENDING_TIMEOUT | head -n 1 | tr "=" "\n" | tail -n 1)

SWITCH_MODE="CTCSS"
if [[ -z "${OLDCTCSSMAPPING}" ]]; then
  SWITCH_MODE="DTMF"
fi

if [[ "${OLDTGS}" == *"--"* ]]; then
  OLDTGS=8
fi

OLDSVXREFL=$(cat /etc/svxlink/svxlink.conf | grep DNS_DOMAIN | head -n 1 | tr "=" "\n" | tail -n 1)
if [[ "${OLDSVXREFL}" == *"--"* ]]; then
  OLDSVXREFL="hostname"
fi
OLDSVXCALL=$(cat /etc/svxlink/svxlink.conf | grep CALLSIGN | tr "=" "\n" | grep \" | tr -cd '[:alnum:]._-')
if [[ "${OLDSVXCALL}" == *"--"* ]]; then
  OLDSVXCALL="ON0RFG"
fi
OLDSVXEMAIL=$(grep CERT_EMAIL /etc/svxlink/svxlink.conf | tr "=" "\n" | grep \" | tr -cd '[:alnum:]._@-')
if [[ "${OLDSVXEMAIL}" == *"--"* ]]; then
  OLDSVXEMAIL="nobody@no.one"
fi

gum style --border normal --margin "1" --padding "1 2" --border-foreground "#04B575" "$(gum style --foreground 3 'RF.')Guru $(gum style --foreground 3 '-') Hotspot Talkgroups"

if [[ "${SWITCH_MODE}" == "DTMF" ]]; then
  # DTMF switching — no per-tone mapping. The first monitored TG will
  # become DEFAULT_TG so the box boots straight onto the user's main
  # TG. To change switching method (or the RX squelch tone) use
  # hotspot-config, not this tool.
  say "DTMF switching detected — no per-tone CTCSS mapping. Configuring monitored talkgroups only; the first one becomes the default TG."
  CTCSSMAPPING=""
else
  gum style --foreground "#04B575" "Enter CTCSS tone mapping (<tone>:<talkgroup>,...) (67.0, 71.9, 74.4, 77.0, 79.7, 82.5, 85.4):"
  if [[ "${OLDCTCSSMAPPING}" == "" ]]; then
    OLDCTCSSMAPPING="67.0:8400,69.3:8,71.9:23,74.4:9000"
  fi
  CTCSSMAPPING=$(gum input --value "${OLDCTCSSMAPPING}")
  gum style --foreground 212 "${CTCSSMAPPING}"
fi

gum style --foreground "#04B575" "Enter talk groups to monitor:"
if [[ "${OLDTGS}" == "" ]]; then
  OLDTGS=8
fi
TGS=$(gum input --value "${OLDTGS}")
gum style --foreground 212 "${TGS}"

EPOCH=$(date +%s)

say "Backup old config"
run "cp /etc/svxlink/svxlink.conf /tmp/svxlink.conf.${EPOCH}"
run "rm -f /tmp/svxlink.conf"
say "Downloading latest config template"
run "wget -O /tmp/svxlink.conf https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/svxlink.conf > /dev/null 2>&1"
say "Applying configuration"
cp /tmp/svxlink.conf /etc/svxlink/svxlink.conf

# Rewrite hardcoded gpiochip0 in the template to whatever the
# hotspot-gpiochip helper says owns the 40-pin header on this Pi
# (Pi 5's RP1 lives on gpiochip4-ish, not gpiochip0). Same substitution
# hotspot-config-online applies. Falls back to gpiochip0 if the
# helper isn't installed yet — matches historical behaviour.
if command -v /usr/local/bin/hotspot-gpiochip >/dev/null 2>&1; then
  GPIOCHIP=$(/usr/local/bin/hotspot-gpiochip)
else
  GPIOCHIP=gpiochip0
fi
perl -i -pe "s/^(\\w+_GPIOD_CHIP=)gpiochip[0-9]+/\${1}${GPIOCHIP}/" /etc/svxlink/svxlink.conf

perl -i -pe "s/--HOST--/${OLDSVXREFL}/g" /etc/svxlink/svxlink.conf
perl -i -pe "s/--CALL--/${CALL}/g" /etc/svxlink/svxlink.conf
perl -i -pe "s/--CTCSSMAPPING--/${CTCSSMAPPING}/g" /etc/svxlink/svxlink.conf
# CTCSS_FQ is only meaningful in CTCSS-switching mode (svxlink does
# software decode of each mapped tone). In DTMF mode the chip does
# the decode and CTCSS_FQ gets commented out by the DTMF-mode block
# below anyway, so its value here doesn't matter — leave it empty.
if [[ "${SWITCH_MODE}" == "CTCSS" ]]; then
  CTCSSLIST=$(echo "${CTCSSMAPPING}" | tr ',' '\n' | cut -d':' -f1 | tr '\n' ',' | sed 's/,$//')
else
  CTCSSLIST=""
fi
perl -i -pe "s/--CTCSSLIST--/${CTCSSLIST}/g" /etc/svxlink/svxlink.conf
perl -i -pe "s/--TGS--/${TGS}/g" /etc/svxlink/svxlink.conf
perl -i -pe "s/--CALL--/${CALL}/g" /etc/svxlink/node_info.json
perl -i -pe "s/--SVXCALL--/${OLDSVXCALL}/g" /etc/svxlink/svxlink.conf
perl -i -pe "s/--SVXEMAIL--/$(printf '%s' "$OLDSVXEMAIL" | sed 's/@/\\@/g')/g" /etc/svxlink/svxlink.conf

# Re-apply the DTMF-mode overrides — we just cp'd the generic template
# which always has SQL_DET=CTCSS / DEEMPHASIS=1 / PREEMPHASIS=1. On a
# DTMF-mode box those would re-break squelch (svxlink would try to
# software-decode CTCSS when the chip already gates it via GPIO12)
# and double the emphasis. Same substitutions as hotspot-config-online's
# DTMF-mode branch, kept in sync.
if [[ "${SWITCH_MODE}" == "DTMF" ]]; then
  perl -i -pe "s/^(SQL_DET=CTCSS)\$/#\$1\nSQL_DET=GPIOD\nSQL_GPIOD_CHIP=${GPIOCHIP}\nSQL_GPIOD_LINE=!12/" /etc/svxlink/svxlink.conf
  perl -i -pe 's/^(CTCSS_MODE=.*)$/#$1/'        /etc/svxlink/svxlink.conf
  perl -i -pe 's/^(CTCSS_FQ=.*)$/#$1/'          /etc/svxlink/svxlink.conf
  perl -i -pe 's/^(CTCSS_TO_TG_DELAY=.*)$/#$1/' /etc/svxlink/svxlink.conf
  perl -i -pe 's/^DEEMPHASIS=.*$/DEEMPHASIS=0/'  /etc/svxlink/svxlink.conf
  perl -i -pe 's/^PREEMPHASIS=.*$/PREEMPHASIS=0/' /etc/svxlink/svxlink.conf

  # DEFAULT_TG = first numeric entry in the monitored-TG list. sed
  # (not tr -d) on the per-line strip so newlines aren't collapsed.
  FIRST_TG=$(echo "${TGS}" | tr ',' '\n' | sed 's/[+[:space:]]//g' | grep -E '^[0-9]+$' | head -n1)
  if [[ -n "${FIRST_TG}" ]]; then
    say "Setting DEFAULT_TG=${FIRST_TG} (first monitored TG)"
    perl -i -pe "s/^DEFAULT_TG=.*\$/DEFAULT_TG=${FIRST_TG}/" /etc/svxlink/svxlink.conf
  fi
fi

run "systemctl restart svxlink"
run "systemctl restart fmchip-monitor"

[Unit]
Description=Disable WLAN if WWAN has an IP

[Service]
Type=oneshot
# Run only if wwan0 has an IPv4 or IPv6 address at that moment
ExecCondition=/bin/sh -c 'ip -4 -o addr show dev wwan0 | grep -q " inet " || ip -6 -o addr show dev wwan0 | grep -q " inet6 "'
ExecStart=/usr/bin/logger -t disable-wlan "wwan0 has IP -> dropping Wi-Fi (via wlan-state)"
# wlan-state knows about BT: on combo chips with BT installed it keeps
# the netdev up (only stops AccessPopup) so BT advertising still works.
# On non-BT boxes it ip-link-down's wlan0 as before.
ExecStart=/usr/sbin/wlan-state down

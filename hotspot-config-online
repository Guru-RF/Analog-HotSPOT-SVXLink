TERM=xterm-256color

FILE=/usr/sbin/fmchip-monitor
if [ ! -f $FILE ]; then
  echo "Your image is outdated please upgrade !!!"
  exit
fi

run() {
  exec=$1
  printf "\x1b[38;5;104m --> ${exec}\x1b[39m\n"
  eval ${exec}
}

say () {
  say=$1
  printf "\x1b[38;5;220m${say}\x1b[38;5;255m\n"
}

# Detect the serial port the SA818 is wired to. Prefer /dev/serial0 — the
# kernel-maintained symlink to whatever UART is on GPIO 14/15, regardless
# of whether BT is installed (which steals PL011) or whether the kernel
# renamed ttyAMA0 to ttyAMA10 (Pi 5 / newer device-tree). ttyAMA0 / ttyS0
# stay as fallbacks for ancient images where the serial0 alias is missing.
if [ -e /dev/serial0 ]; then
  SERIAL_PORT="/dev/serial0"
elif [ -e /dev/ttyAMA0 ]; then
  SERIAL_PORT="/dev/ttyAMA0"
else
  SERIAL_PORT="/dev/ttyS0"
fi
say "Using serial port ${SERIAL_PORT}"

# Refresh detection tooling from upstream BEFORE we use it. Otherwise any
# newly-added strap (new GPIOs, GENERATION/POWER fields, sa818 chip
# variants, …) is detected only on the *next* config run, because the
# regular auto-update block doesn't fire until after the user has already
# answered every prompt. Stage each download to /tmp first so a
# half-finished wget can't brick the installed copy. Soft-fail on no
# internet / GitHub down — the existing installed copies keep being used.
say "Refreshing hotspot-detect from upstream"
if wget -q -O /tmp/hotspot-detect.new https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-detect 2>/dev/null \
   && [ -s /tmp/hotspot-detect.new ]; then
  mv /tmp/hotspot-detect.new /usr/sbin/hotspot-detect
  chmod +x /usr/sbin/hotspot-detect
else
  say "Could not refresh hotspot-detect (offline?), using installed copy"
  rm -f /tmp/hotspot-detect.new
fi

say "Refreshing sa818 firmware module from upstream"
if wget -q -O /tmp/sa818.new https://raw.githubusercontent.com/Guru-RF/SA818/main/sa818.py 2>/dev/null \
   && [ -s /tmp/sa818.new ]; then
  mv /tmp/sa818.new /usr/local/bin/sa818
  chmod +x /usr/local/bin/sa818
else
  say "Could not refresh sa818 (offline?), using installed copy"
  rm -f /tmp/sa818.new
fi

say "Refreshing hotspot-audio-detect from upstream"
if wget -q -O /tmp/hotspot-audio-detect.new https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-audio-detect 2>/dev/null \
   && [ -s /tmp/hotspot-audio-detect.new ]; then
  install -m 755 /tmp/hotspot-audio-detect.new /usr/local/bin/hotspot-audio-detect
  rm -f /tmp/hotspot-audio-detect.new
else
  say "Could not refresh hotspot-audio-detect (offline?), using installed copy"
  rm -f /tmp/hotspot-audio-detect.new
fi

# hotspot-tune-volume is refreshed at the TOP of the script (with the
# other early refreshes) rather than in the trailing auto-update block,
# because we CALL it later in the commit-changes branch — a first-time
# upgrade from a pre-tune-volume install would otherwise silently
# skip the tune (invocation guard [ -x ... ] returns false, then the
# download fires afterwards, then the run ends). Staged install so a
# half-finished wget can't leave a zero-byte executable that would
# silently no-op on every subsequent boot.
say "Refreshing hotspot-tune-volume from upstream"
if wget -q -O /tmp/hotspot-tune-volume.new https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-tune-volume 2>/dev/null \
   && [ -s /tmp/hotspot-tune-volume.new ]; then
  install -m 755 /tmp/hotspot-tune-volume.new /usr/sbin/hotspot-tune-volume
  rm -f /tmp/hotspot-tune-volume.new
else
  say "Could not refresh hotspot-tune-volume (offline?), using installed copy"
  rm -f /tmp/hotspot-tune-volume.new
fi

# Detect the board (GPIO straps) BEFORE the chip — the board generation is
# authoritative for the audio path and is independent of whatever the
# SA818 says about itself over serial. The chip-detect call comes next
# and may take a second or two to talk to the radio.
echo ""
HOTSPOT_DETECT_OUT=$(/usr/sbin/hotspot-detect 2>&1)
echo "${HOTSPOT_DETECT_OUT}"
DETECTED_BAND=$(echo "${HOTSPOT_DETECT_OUT}"       | awk -F': ' '/^BAND:/ {print $2}')
DETECTED_GENERATION=$(echo "${HOTSPOT_DETECT_OUT}" | awk -F': ' '/^GENERATION:/ {print $2}')
DETECTED_POWER=$(echo "${HOTSPOT_DETECT_OUT}"      | awk -F': ' '/^POWER:/ {print $2}')
echo ""

# Pi board detection + safety cleanup. The Pi Zero 2W tolerates (and
# needs, in the plastic case) the aggressive undervolt/underclock that
# hotspot-options writes into config.txt / cmdline.txt:
#   arm_freq=700 / arm_freq_min=500 / over_voltage=-6 /
#   gpu_freq=150 / core_freq=150 / hdmi_blanking=1 / maxcpus=2
# On Pi 4 and Pi 5 those settings break UART bit-timing (mini-UART is
# clocked off core_freq — pinning it to 150 MHz kills SA818 comms) and
# generally cripple perfectly capable hardware. So if we ever see this
# tuning on a non-Zero-2W board (e.g. an SD card that was moved from a
# Pi Zero 2W into a Pi 4/5), strip it here as part of hotspot-config
# so the user never has to hunt for it.
PI_MODEL=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || echo "unknown")
IS_PI_ZERO2W=0
case "$PI_MODEL" in
  *"Pi Zero 2"*) IS_PI_ZERO2W=1 ;;
esac
say "Detected board: ${PI_MODEL}"

if [ "$IS_PI_ZERO2W" -ne 1 ]; then
  CONFIG_TXT="/boot/firmware/config.txt"
  CMDLINE_TXT="/boot/firmware/cmdline.txt"
  STRIPPED=0
  if [ -f "$CONFIG_TXT" ]; then
    for setting in "arm_freq=700" "arm_freq_min=500" "over_voltage=-6" "gpu_freq=150" "core_freq=150" "hdmi_blanking=1"; do
      if grep -q "^${setting}" "$CONFIG_TXT"; then
        sed -i "\|^${setting}|d" "$CONFIG_TXT"
        say "  removed ${setting} from ${CONFIG_TXT} (Pi Zero 2W tuning, unsafe on ${PI_MODEL})"
        STRIPPED=1
      fi
    done
  fi
  if [ -f "$CMDLINE_TXT" ] && grep -q "maxcpus=2" "$CMDLINE_TXT"; then
    sed -i "s/\bmaxcpus=2\b//g" "$CMDLINE_TXT"
    say "  removed maxcpus=2 from ${CMDLINE_TXT} (Pi Zero 2W tuning, unsafe on ${PI_MODEL})"
    STRIPPED=1
  fi
  if [ "$STRIPPED" -eq 1 ]; then
    say "  Pi Zero 2W CPU/UART tuning stripped — a reboot is needed for the change to take effect."
  fi
fi
echo ""

# Detect chip variant + firmware version and enable/disable monitor accordingly.
# Example output: "SA818: INFO: Firmware SA818, version: V1.0"
#             or: "SA818: INFO: Firmware SA818PRO, version: V1.1"
#             or: "SA818: INFO: Firmware SA868, version: V..."
#
# fmchip-monitor is only needed on the original SA818 silicon at firmware
# V1.0 — exact name "SA818", no suffix. The SA818PRO (any version) and the
# SA868 generation handle the failure modes the monitor was working around,
# so they should run without it.
systemctl stop fmchip-monitor
CHIPRAW=$(sa818 --port ${SERIAL_PORT} version 2>&1)
CHIPNAME=$(echo "${CHIPRAW}" | awk '{print $4}')
CHIPNAME=${CHIPNAME%,}                         # strip trailing comma
CHIPVERSION=$(echo "${CHIPRAW}" | awk '{print $6}')

# Strip leading 'V' (e.g. V1.0 -> 1.0)
NUMVER=${CHIPVERSION#V}
VMAJOR=${NUMVER%%.*}
VMINOR=${NUMVER#*.}

if [[ "${CHIPNAME}" == "SA818" && "${VMAJOR}" == "1" && "${VMINOR}" == "0" ]]; then
  say "old CHIP ${CHIPNAME} version ${CHIPVERSION} detected enabling chip monitor"
  systemctl enable fmchip-monitor
  systemctl start fmchip-monitor
else
  say "CHIP ${CHIPNAME} version ${CHIPVERSION} detected disabling chip monitor"
  systemctl stop fmchip-monitor
  systemctl disable fmchip-monitor
fi

# Three independent capability flags — must NOT be conflated:
#
#   IS_PRO_CHIP   ← chip-name check. Only used to FORCE SWITCH_MODE=DTMF
#                   on SA818PRO: the PRO chip's hardware CTCSS decoder
#                   is fixed to one tone at a time and drives GPIO12
#                   directly, so per-tone CTCSS_TO_TG mapping is
#                   physically impossible. Non-PRO chips (SA818/SA868)
#                   can pick either mode — SWITCH_MODE then drives
#                   everything downstream.
#
#   SWITCH_MODE   ← DTMF or CTCSS. User pick on non-PRO, forced to DTMF
#                   on PRO. Drives the whole squelch + emphasis story:
#                     DTMF  — chip does CTCSS decode + audio filtering
#                             in hardware. svxlink reads squelch off
#                             GPIO12 (SQL_DET=GPIOD), comments CTCSS_*,
#                             sets DEEMPHASIS=0/PREEMPHASIS=0. DEFAULT_TG
#                             becomes the first monitored TG. Same
#                             treatment for every chip.
#                     CTCSS — svxlink does software CTCSS decode with a
#                             per-tone TG mapping (CTCSS_TO_TG). Chip
#                             stays in pass-through (--ctcss TX,0).
#                             svxlink/LADSPA do the audio shaping.
#
#   IS_NEW_BOARD  ← board-generation check. Only drives the RF-audio
#                   ALSA levels: 4th-gen board wants RFVOL=65 (alsa %)
#                   vs older-board RFVOL=0 (SA818 0-23 scale). Does
#                   NOT gate chip filters any more — those are purely
#                   chip+mode driven now.
#
# Chip-filter emission (sa818 filters --emphasis/--highpass/--lowpass)
# in the generated /usr/sbin/hotspot follows THREE cases:
#
#   PRO chip                — skip the filters line entirely. SA818PRO
#                             does emphasis internally and does not
#                             accept the AT+SETFILTER command.
#   SA818/SA868 in DTMF     — enable all three. Chip is already doing
#                             CTCSS decode + squelch (GPIO12), so it
#                             also does emphasis + band-limiting; the
#                             DTMF apply block sets svxlink emphasis
#                             to 0 so we don't shape twice.
#   SA818/SA868 in CTCSS    — disable all three. svxlink does software
#                             CTCSS decode + emphasis (template
#                             defaults DEEMPHASIS=1 / PREEMPHASIS=1
#                             stay in place — no override).
#
# All three flags can be set independently — e.g. a non-PRO chip on
# a 4th-gen board with SWITCH_MODE=DTMF gets chip filters + GPIO12
# squelch and the 4th-gen ALSA levels.
IS_PRO_CHIP=0
if [[ "${CHIPNAME}" == *PRO* ]]; then
  IS_PRO_CHIP=1
fi

IS_NEW_BOARD=0
if [[ "${DETECTED_GENERATION}" == "4" ]]; then
  IS_NEW_BOARD=1
fi

# Audio codec detection. Two codecs are in the field:
#   WM8960          — old boards, out-of-tree Waveshare driver + userspace
#                     helper (wm8960-soundcard.service).
#   TLV320AIC3204   — REV 6+ boards, in-tree snd-soc-tlv320aic32x4 driver
#                     loaded via the audiosense-pi dtoverlay.
# The board-generation strap doesn't distinguish them (REV 6 keeps the
# 4th-gen strap pattern) so we probe the I²C bus. See
# /usr/local/bin/hotspot-audio-detect for the probe details.
AUDIO_CODEC=$(/usr/local/bin/hotspot-audio-detect 2>/dev/null || echo UNKNOWN)
say "Audio codec: ${AUDIO_CODEC}"
if [[ "${AUDIO_CODEC}" == "UNKNOWN" ]]; then
  say "WARNING: no known audio codec on I²C — assuming WM8960 for backwards compat"
  AUDIO_CODEC="WM8960"
fi

# Reconcile /boot/firmware/config.txt with the detected codec. Fresh
# images ship with dtoverlay=wm8960-soundcard; a REV 6 board with that
# overlay produces "no soundcards found" (WM8960 driver probes I²C
# 0x1a which isn't there). Same story in reverse if someone re-flashes
# an old board with a REV6-shaped image. Swap the overlay in place;
# takes effect on next boot (a reboot is prompted at the end anyway).
CONFIG_TXT="/boot/firmware/config.txt"
if [ -f "$CONFIG_TXT" ]; then
  case "$AUDIO_CODEC" in
    TLV320AIC3204)
      if grep -qE '^dtoverlay=wm8960-soundcard' "$CONFIG_TXT"; then
        say "  removing dtoverlay=wm8960-soundcard from ${CONFIG_TXT} (wrong codec for this board)"
        sed -i '/^dtoverlay=wm8960-soundcard/d' "$CONFIG_TXT"
      fi
      if ! grep -qE '^dtoverlay=audiosense-pi' "$CONFIG_TXT"; then
        say "  adding dtoverlay=audiosense-pi to ${CONFIG_TXT} (TLV320AIC3204 driver)"
        echo 'dtoverlay=audiosense-pi' >> "$CONFIG_TXT"
      fi
      # WM8960 userspace helper is now inert. Stop + disable so it
      # doesn't log failures on every boot.
      systemctl disable --now wm8960-soundcard.service >/dev/null 2>&1 || true
      ;;
    WM8960)
      if grep -qE '^dtoverlay=audiosense-pi' "$CONFIG_TXT"; then
        say "  removing dtoverlay=audiosense-pi from ${CONFIG_TXT} (wrong codec for this board)"
        sed -i '/^dtoverlay=audiosense-pi/d' "$CONFIG_TXT"
      fi
      if ! grep -qE '^dtoverlay=wm8960-soundcard' "$CONFIG_TXT"; then
        say "  adding dtoverlay=wm8960-soundcard to ${CONFIG_TXT} (WM8960 driver)"
        echo 'dtoverlay=wm8960-soundcard' >> "$CONFIG_TXT"
      fi
      ;;
  esac
fi

OLDCPVOL=$(grep volume /usr/sbin/hotspot 2>/dev/null | awk '{ print $6 }' | tail -n 1)
# OLDAFVOL / OLDRFVOL come from the previously-generated hotspot_volume;
# control names differ per codec. TLV320AIC3204 uses `PCM` (playback)
# and `PGA Level` (capture); WM8960 uses `Headphone` (playback) and
# `Capture` (capture). Try TLV320 lines first, then fall back to WM8960.
OLDAFVOL=$(grep -E "sset 'PCM' " /usr/sbin/hotspot_volume 2>/dev/null | head -n1 | grep -oE '[0-9]+%' | head -n1 | tr -d '%')
if [ -z "$OLDAFVOL" ]; then
  OLDAFVOL=$(grep Headphone /usr/sbin/hotspot_volume 2>/dev/null | awk '{ print $4 }' | tail -n 1 | sed 's/%$//')
fi
OLDRFVOL=$(grep -E "sset 'PGA Level' " /usr/sbin/hotspot_volume 2>/dev/null | head -n1 | grep -oE '[0-9]+%' | head -n1 | tr -d '%')
if [ -z "$OLDRFVOL" ]; then
  OLDRFVOL=$(grep Capture /usr/sbin/hotspot_volume 2>/dev/null | awk '{ print $4 }' | tail -n 1 | sed 's/%$//')
fi
OLDFREQ=$(grep freq /usr/sbin/hotspot 2>/dev/null | head -n1 | awk '{ print $8 }')

# Read old CTCSS *TX* tone from [Tx1] section in svxlink.conf
OLDCTCSS=$(
  sed -n \
    's/.*--ctcss[[:space:]]*\([0-9.]\+\),.*/\1/p' \
    /usr/sbin/hotspot \
  | head -n1
)

# Read old CTCSS *RX* tone (the value after the comma in --ctcss TX,RX —
# always 0 on non-PRO chips, may be a real tone on SA818PRO).
OLDCTCSSRX=$(
  sed -n \
    's/.*--ctcss[[:space:]]*[0-9.]\+,\([0-9.]\+\).*/\1/p' \
    /usr/sbin/hotspot \
  | head -n1
)

OLDCTCSSMAPPING=$(grep CTCSS_TO_TG /etc/svxlink/svxlink.conf 2>/dev/null | head -n 1 | tr "=" "\n" | tail -n 1)
OLDCALL=$(grep CALL /etc/svxlink/svxlink.conf 2>/dev/null | head -n 1 | tr "=" "\n" | tail -n 1)
OLDTGS=$(grep MONITOR_TGS /etc/svxlink/svxlink.conf 2>/dev/null | head -n 1 | tr "=" "\n" | tail -n 1)
OLDLOCATION=$(grep -i location /etc/svxlink/node_info.json 2>/dev/null | awk '{ print $2 }' | tr "," "\n" | tr -cd '[:alnum:]._-')
OLDLAT=$(grep -i lat /etc/svxlink/node_info.json 2>/dev/null | awk '{ print $2 }' | tr "," "\n" | tr -cd '[:alnum:]._-')
OLDLON=$(grep -i lon /etc/svxlink/node_info.json 2>/dev/null | awk '{ print $2 }' | tr "," "\n" | tr -cd '[:alnum:]._-')
OLDLOC=$(grep -i loc /etc/svxlink/node_info.json 2>/dev/null | awk '{ print $2 }' | tr "," "\n" | tail -n 1 | tr -cd '[:alnum:]._-')
QSYTIMEOUT=$(grep QSY_PENDING_TIMEOUT /etc/svxlink/svxlink.conf 2>/dev/null | head -n 1 | tr "=" "\n" | tail -n 1)

if [[ "${OLDTGS}" == *"--"* ]]; then
  OLDTGS=8
fi
if [[ "${OLDLAT}" == *"--"* ]]; then
  OLDLAT="50.4707972"
fi
if [[ "${OLDLON}" == *"--"* ]]; then
  OLDLON="3.8624516"
fi
if [[ "${OLDLOC}" == *"--"* ]]; then
  OLDLOC="JO10VK"
fi
if [[ "${OLDCALL}" == *"--"* || "${OLDCALL}" == "" ]]; then
  OLDCALL="ON0RFG"
fi

OLDSVXREFL=$(grep DNS_DOMAIN /etc/svxlink/svxlink.conf 2>/dev/null | head -n 1 | tr "=" "\n" | tail -n 1)
if [[ "${OLDSVXREFL}" == *"--"* || "${OLDSVXREFL}" == "" ]]; then
  OLDSVXREFL="hostname"
fi

OLDSVXCALL=$(grep CALLSIGN /etc/svxlink/svxlink.conf 2>/dev/null | tr "=" "\n" | grep \" | tr -cd '[:alnum:]._-')
if [[ "${OLDSVXCALL}" == *"--"* || "${OLDSVXCALL}" == "" ]]; then
  OLDSVXCALL="ON0RFG"
fi

OLDSVXEMAIL=$(grep CERT_EMAIL /etc/svxlink/svxlink.conf 2>/dev/null | tr "=" "\n" | grep \" | tr -cd '[:alnum:]._@-')
if [[ "${OLDSVXEMAIL}" == *"--"* || "${OLDSVXEMAIL}" == "" ]]; then
  OLDSVXEMAIL="nobody@no.one"
fi

gum style --border normal --margin "1" --padding "1 2" --border-foreground "#04B575" "$(gum style --foreground 3 'RF.')Guru $(gum style --foreground 3 '-') Hotspot Config"

gum style --foreground "#04B575" "Callsign:"
CALL=$(gum input --value "${OLDCALL}")
if [[ "${CALL}" == "" ]]; then
  CALL=${OLDCALL}
fi
gum style --foreground 212 "${CALL}"

gum style --foreground "#04B575" "SVXLink Domain:"
REFLECTOR=$(gum input --value "${OLDSVXREFL}")
if [[ "${REFLECTOR}" == "" ]]; then
  REFLECTOR=${OLDSVXREFL}
fi
gum style --foreground 212 "${REFLECTOR}"

gum style --foreground "#04B575" "SVXLINK Reflector User Callsign:"
SVXCALL=$(gum input --value "${OLDSVXCALL}")
if [[ "${SVXCALL}" == "" ]]; then
  SVXCALL=${OLDSVXCALL}
fi
gum style --foreground 212 "${SVXCALL}"

gum style --foreground "#04B575" "SVXLINK Reflector User Certificate Email:"
SVXEMAIL=$(gum input --value "${OLDSVXEMAIL}")
if [[ "${SVXEMAIL}" == "" ]]; then
  SVXEMAIL=${OLDSVXEMAIL}
fi
gum style --foreground 212 "${SVXEMAIL}"

# Hostname — defaults to the reflector user callsign so the box advertises
# itself on the LAN as ${SVXCALL}.local once mDNS picks it up. Reuse the
# current system hostname as the in-place default if the user has already
# customised it, so re-running config doesn't quietly reset it. Forced to
# lowercase: Linux/DNS hostnames are conventionally lowercase and some
# tools choke on uppercase letters.
OLDHOSTNAME=$(hostname 2>/dev/null)
if [[ -z "${OLDHOSTNAME}" || "${OLDHOSTNAME}" == "hotspot" || "${OLDHOSTNAME}" == "raspberrypi" ]]; then
  OLDHOSTNAME="${SVXCALL}"
fi
OLDHOSTNAME="${OLDHOSTNAME,,}"
gum style --foreground "#04B575" "Hostname (default: ${OLDHOSTNAME}):"
NEW_HOSTNAME=$(gum input --value "${OLDHOSTNAME}")
if [[ -z "${NEW_HOSTNAME}" ]]; then
  NEW_HOSTNAME="${OLDHOSTNAME}"
fi
NEW_HOSTNAME="${NEW_HOSTNAME,,}"
gum style --foreground 212 "${NEW_HOSTNAME}"

gum style --foreground "#04B575" "Band:"
# Prefer the GPIO-detected band from hotspot-detect over OLDFREQ guessing
# — the hat ID pins are authoritative. Fall back to OLDFREQ when the hat
# is too old to report a band (returns UNKNOWN_BAND).
if [[ "${DETECTED_BAND}" == "VHF" ]]; then
  BAND=$(gum choose "2m" "70cm")
elif [[ "${DETECTED_BAND}" == "UHF" ]]; then
  BAND=$(gum choose "70cm" "2m")
elif [[ "${OLDFREQ}" == 1* ]]; then
  BAND=$(gum choose "2m" "70cm")
else
  BAND=$(gum choose "70cm" "2m")
fi
gum style --foreground 212 "${BAND}"

gum style --foreground "#04B575" "Frequency:"

if [ "${BAND}" = "70cm" ]; then
  DEF_FREQ_70="434.925"

  if [[ -z "${OLDFREQ}" ]]; then
    OLDFREQ="${DEF_FREQ_70}"
  fi

  # If previous freq looks like UHF (starts with 4), reuse it
  if [[ "${OLDFREQ}" == 4* ]]; then
    FREQ=$(gum input --value "${OLDFREQ}")
  else
    FREQ=$(gum input --value "${DEF_FREQ_70}")
  fi
fi

if [ "${BAND}" = "2m" ]; then
  DEF_FREQ_2M="145.925"

  if [[ -z "${OLDFREQ}" ]]; then
    OLDFREQ="${DEF_FREQ_2M}"
  fi

  # If previous freq looks like VHF (starts with 1), reuse it
  if [[ "${OLDFREQ}" == 1* ]]; then
    FREQ=$(gum input --value "${OLDFREQ}")
  else
    FREQ=$(gum input --value "${DEF_FREQ_2M}")
  fi
fi

# Talkgroup-switching method. Two independent axes:
#
#   IS_PRO_CHIP=1 → SA818PRO. Chip decodes ONE CTCSS tone in hardware and
#     asserts GPIO12; svxlink reads that as squelch (SQL_DET=GPIOD) and
#     never sees the audio-side tone, so per-tone TG switching is
#     physically impossible. Forced to DTMF.
#
#   IS_PRO_CHIP=0 → plain SA818 / SA868. svxlink does software CTCSS
#     decode over the whole audio band. Both modes are possible:
#       - DTMF  : single RX tone opens squelch; user dials DTMF codes
#                 to change TG. DEFAULT_TG is the first monitored TG so
#                 the box boots ready-to-talk.
#       - CTCSS : per-tone→TG mapping. Squelch opens on any tone in the
#                 list; svxlink switches to the mapped TG. Traditional
#                 hotspot behaviour.
#
# We preserve the user's previous choice by inspecting the running
# CTCSS_TO_TG value (empty ⇒ they were on DTMF).
if [[ "${IS_PRO_CHIP}" == "1" ]]; then
  SWITCH_MODE="DTMF"
  say "SA818PRO detected — TG switching is DTMF (chip decodes one CTCSS tone to GPIO12 in hardware; per-tone mapping is impossible)."
else
  # Preselect: previous choice if there's an existing svxlink.conf,
  # otherwise CTCSS (the historical non-PRO default on a fresh install).
  if [[ ! -f /etc/svxlink/svxlink.conf ]]; then
    OLDSWITCH="CTCSS"
  elif [[ -n "${OLDCTCSSMAPPING}" && "${OLDCTCSSMAPPING}" != "--CTCSSMAPPING--" ]]; then
    OLDSWITCH="CTCSS"
  else
    OLDSWITCH="DTMF"
  fi
  gum style --foreground "#04B575" "Talkgroup switching method:"
  say "  DTMF  — single RX CTCSS tone opens squelch; dial a DTMF code to change TG."
  say "  CTCSS — per-tone mapping; transmit a mapped tone to change TG."
  SWITCH_MODE=$(gum choose --selected "${OLDSWITCH}" "DTMF" "CTCSS")
  gum style --foreground 212 "${SWITCH_MODE}"
fi

if [[ "${SWITCH_MODE}" == "DTMF" ]]; then
  # One RX tone for squelch. Every chip variant (SA818 / SA818PRO /
  # SA868 / VHF or UHF) has the same story in DTMF mode: the chip
  # decodes the CTCSS tone in hardware, drives its SQ pin, and the
  # board wires that pin to GPIO12 (Pin 32, "COS input" — see
  # README.md § GPIO Pin Usage). svxlink then reads squelch off
  # GPIO12 (SQL_DET=GPIOD) and stays out of the audio-shaping path
  # entirely — chip does emphasis + band-limiting too (see the
  # filter-enable line further down, and the SWITCH_MODE=DTMF block
  # in the apply section that sets DEEMPHASIS=0/PREEMPHASIS=0). This
  # is the same treatment PRO chips have always had; extending it to
  # non-PRO in DTMF mode offloads the CTCSS decode from svxlink and
  # avoids double-emphasis.
  gum style --foreground "#04B575" "Enter RX CTCSS tone (default 88.5) (67.0, 71.9, 74.4, 77.0, 79.7, 82.5, 85.4, 88.5):"
  if [[ "${OLDCTCSSRX}" == "" || "${OLDCTCSSRX}" == "0" ]]; then
    OLDCTCSSRX="88.5"
  fi
  RXTONE=$(gum input --value "${OLDCTCSSRX}")
  if [[ "${RXTONE}" == "" ]]; then
    RXTONE="${OLDCTCSSRX}"
  fi
  gum style --foreground 212 "${RXTONE}"
  CTCSSMAPPING=""       # CTCSS_TO_TG stays empty → no per-tone TG switching
  CTCSSRX="${RXTONE}"   # chip decodes this tone, its SQ pin drives GPIO12
  CTCSSLIST=""          # CTCSS_FQ gets commented in the DTMF-apply block
else
  # CTCSS mode is non-PRO only (PRO forces DTMF above).
  gum style --foreground "#04B575" "Enter CTCSS tone mapping (<tone>:<talkgroup>,...) (67:4,69.3:8,71.9:6,74.4:23,77.0:1745,79.7:8400,82.5:2300,85.4:9000,88.5:8401):"
  if [[ "${OLDCTCSSMAPPING}" == "--CTCSSMAPPING--" ]]; then
    OLDCTCSSMAPPING="67.0:8400,69.3:8,71.9:23,74.4:9000"
  fi
  if [[ "${OLDCTCSSMAPPING}" == "" ]]; then
    OLDCTCSSMAPPING="67.0:8400,69.3:8,71.9:23,74.4:9000"
  fi
  CTCSSMAPPING=$(gum input --value "${OLDCTCSSMAPPING}")
  gum style --foreground 212 "${CTCSSMAPPING}"
  CTCSSRX=0
  # CTCSSLIST is derived from the mapping down in the apply block.
fi

# Always ask for CTCSS TX tone (from Tx1 CTCSS_FQ)
gum style --foreground "#04B575" "Enter CTCSS TX tone (default 67) (67.0, 71.9, 74.4, 77.0, 79.7, 82.5, 85.4, 88.5):"
if [[ "${OLDCTCSS}" == "" || "${OLDCTCSS}" == "--TXCTCSS--" ]]; then
  OLDCTCSS="88.5"
fi
CTCSSTX=$(gum input --value "${OLDCTCSS}")
if [[ "${CTCSSTX}" == "" ]]; then
  CTCSSTX="${OLDCTCSS}"
fi
gum style --foreground 212 "${CTCSSTX}"

gum style --foreground "#04B575" "Enter Location — a full street address gives accurate coordinates; only the city is saved to the public node info (defaults to Belgium if no country):"
if [[ "${OLDLOCATION}" == "" ]]; then
  OLDLOCATION="Saint Ghislain"
fi
LOCATION=$(gum input --value "${OLDLOCATION}")
gum style --foreground 212 "${LOCATION}"

# For the geocoding query only, append ", Belgium" when the user didn't
# specify a country. Keeps the lookup universal (a Dutch ham can type
# "Utrecht, Netherlands"; a French one "Lille, France") while still
# defaulting nicely for our primary Belgian audience.
LOCATION_QUERY="${LOCATION}"
if [[ "${LOCATION_QUERY}" != *","* ]]; then
  LOCATION_QUERY="${LOCATION}, Belgium"
fi

# Try to prefill lat/lon/gridsquare via Nominatim (OpenStreetMap). Free,
# no API key, requires a User-Agent per their usage policy.
#
# Privacy: the user is invited to type a full street address for accurate
# coordinates, but the value we keep in LOCATION (which ends up in
# node_info.json and from there on the dashboard / reflector / APRS) is
# replaced with just the city/town extracted from the lookup. We add
# addressdetails=1 to get those structured fields back.
#
# If anything fails (no curl, no internet, no match, python3 missing) the
# previously-saved OLDLAT/OLDLON/OLDLOC are kept and LOCATION stays as
# the user typed it.
if command -v curl >/dev/null 2>&1; then
  say "Looking up coordinates for ${LOCATION_QUERY}..."
  LOOKUP_JSON=$(curl -sG --connect-timeout 5 --max-time 10 \
    -H "User-Agent: rfguru-hotspot-config/1.0 (https://github.com/Guru-RF/Analog-HotSPOT-SVXLink)" \
    --data-urlencode "q=${LOCATION_QUERY}" \
    --data "format=json&limit=1&addressdetails=1" \
    "https://nominatim.openstreetmap.org/search" 2>/dev/null || true)
  if [[ -n "${LOOKUP_JSON}" && "${LOOKUP_JSON}" != "[]" ]]; then
    # Output is tab-separated so multi-word city names ("Saint Ghislain")
    # survive `read`. Python emits exactly four fields.
    GEO=$(echo "${LOOKUP_JSON}" | python3 -c '
import json, sys
try:
    data = json.loads(sys.stdin.read())
    if not data:
        sys.exit(0)
    entry = data[0]
    lat = float(entry["lat"])
    lon = float(entry["lon"])
    al, ao = lat + 90, lon + 180
    grid = (
        chr(ord("A") + int(ao / 20))
        + chr(ord("A") + int(al / 10))
        + str(int(ao % 20 / 2))
        + str(int(al % 10))
        + chr(ord("a") + int((ao % 2) * 12))
        + chr(ord("a") + int((al % 1) * 24))
    )
    addr = entry.get("address") or {}
    city = (
        addr.get("city") or addr.get("town") or addr.get("village")
        or addr.get("hamlet") or addr.get("municipality")
        or addr.get("county") or ""
    )
    print(f"{lat:.7f}\t{lon:.7f}\t{grid.upper()}\t{city}")
except Exception:
    pass
' 2>/dev/null || true)
    if [[ -n "${GEO}" ]]; then
      IFS=$'\t' read -r OLDLAT OLDLON OLDLOC LOOKUP_CITY <<< "${GEO}"
      if [[ -n "${LOOKUP_CITY}" ]]; then
        say "Found: ${OLDLAT}, ${OLDLON} (${OLDLOC}) — saving location as '${LOOKUP_CITY}' (no street address stored)"
        LOCATION="${LOOKUP_CITY}"
      else
        say "Found: ${OLDLAT}, ${OLDLON} (${OLDLOC}) — no city field in result, keeping '${LOCATION}' as entered"
      fi
    else
      say "Lookup returned no usable result, keeping previous coordinates"
    fi
  else
    say "No match for '${LOCATION_QUERY}', keeping previous coordinates"
  fi
fi

gum style --foreground "#04B575" "Enter Latitude:"
if [[ "${OLDLAT}" == "" ]]; then
  OLDLAT="50.4707972"
fi
LAT=$(gum input --value "${OLDLAT}")
gum style --foreground 212 "${LAT}"

gum style --foreground "#04B575" "Enter Longitude:"
if [[ "${OLDLON}" == "" ]]; then
  OLDLON="3.8624516"
fi
LON=$(gum input --value "${OLDLON}")
gum style --foreground 212 "${LON}"

gum style --foreground "#04B575" "Enter Gridsquare:"
if [[ "${OLDLOC}" == "" ]]; then
  OLDLOC="JO10VK"
fi
LOC=$(gum input --value "${OLDLOC}")
gum style --foreground 212 "${LOC}"

gum style --foreground "#04B575" "Enter talk groups to monitor:"
if [[ "${OLDTGS}" == "" ]]; then
  OLDTGS=8
fi
TGS=$(gum input --value "${OLDTGS}")
gum style --foreground 212 "${TGS}"

# AFVOL / RFVOL defaults are codec-specific. TLV320AIC3204 (REV 6+)
# wants a hotter TX drive (85%) and a much lower RX gain (20%) than
# the WM8960 analog chain did — the codec's PGA stage runs at
# ~31 dB per 65% (see amixer sget 'PGA Level' output), so 65% would
# ride the sa818's line-out into clipping.
if [[ "${AUDIO_CODEC}" == "TLV320AIC3204" ]]; then
  gum style --foreground "#04B575" "Enter AF output volume [50-99] (default 85 for TLV320AIC3204):"
  AFVOL=85
else
  gum style --foreground "#04B575" "Enter AF output volume [50-99] (default 77):"
  AFVOL=77
fi
gum style --foreground 212 "${AFVOL}"

if [[ "${AUDIO_CODEC}" == "TLV320AIC3204" ]]; then
  gum style --foreground "#04B575" "Enter RF input volume [0-100] (default 20 for TLV320AIC3204):"
  RFVOL=20
elif [[ "${IS_NEW_BOARD}" == "1" ]]; then
  gum style --foreground "#04B575" "Enter RF input volume [0-100] (default 65 for 4th-gen board):"
  RFVOL=65
else
  gum style --foreground "#04B575" "Enter RF input volume [0-23] (default 0):"
  RFVOL=0
fi
gum style --foreground 212 "${RFVOL}"

if [[ "${OLDCPVOL}" == "" ]]; then
  OLDCPVOL="1"
fi
gum style --foreground "#04B575" "Enter RF compression [1-8] (default 1):"
CPVOL=1
gum style --foreground 212 "${CPVOL}"

EPOCH=$(date +%s)

gum confirm "Commit changes?"

RESULT=$?
if [ $RESULT -eq 0 ]; then
  say "Backup old config"
  run "cp /etc/svxlink/svxlink.conf /tmp/svxlink.conf.${EPOCH}"
  run "cp /etc/svxlink/node_info.json /tmp/node_info.json.${EPOCH}"
  run "rm -f /tmp/svxlink.conf"

  # sa818 was already refreshed at script start so chip detection used
  # the latest version — no second download here.

  say "Downloading fmchip-monitor"
  run "wget -O /usr/sbin/fmchip-monitor https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/fmchip-monitor.py > /dev/null 2>&1"
  run "chmod +x /usr/sbin/fmchip-monitor"

  say "Downloading latest config template"
  run "wget -O /tmp/svxlink.conf https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/svxlink.conf > /dev/null 2>&1"
  run "wget -O /tmp/node_info.json https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/node_info.json > /dev/null 2>&1"

  say "Applying configuration"
  cp /tmp/svxlink.conf /etc/svxlink/svxlink.conf
  cp /tmp/node_info.json /etc/svxlink/node_info.json

  perl -i -pe "s/--HOST--/${REFLECTOR}/g" /etc/svxlink/svxlink.conf
  perl -i -pe "s/--CALL--/${CALL}/g" /etc/svxlink/svxlink.conf
  perl -i -pe "s/--CTCSSMAPPING--/${CTCSSMAPPING}/g" /etc/svxlink/svxlink.conf
  # In CTCSS switching mode CTCSSLIST is the set of tones svxlink must
  # decode, derived from the mapping keys. In DTMF mode CTCSSLIST was
  # already set at prompt time (single tone on non-PRO, empty on PRO)
  # so don't overwrite it here.
  if [[ "${SWITCH_MODE}" == "CTCSS" ]]; then
    CTCSSLIST=$(echo "${CTCSSMAPPING}" | tr ',' '\n' | cut -d':' -f1 | tr '\n' ',' | sed 's/,$//')
  fi
  perl -i -pe "s/--CTCSSLIST--/${CTCSSLIST}/g" /etc/svxlink/svxlink.conf
  perl -i -pe "s/--TGS--/${TGS}/g" /etc/svxlink/svxlink.conf
  perl -i -pe "s/--CALL--/${CALL}/g" /etc/svxlink/node_info.json
  perl -i -pe "s/--SVXCALL--/${SVXCALL}/g" /etc/svxlink/svxlink.conf
  perl -i -pe "s/--SVXEMAIL--/$(printf '%s' "$SVXEMAIL" | sed 's/@/\\@/g')/g" /etc/svxlink/svxlink.conf
  # Write selected TX CTCSS into placeholder in svxlink.conf
  #perl -i -pe "s/--TXCTCSS--/${CTCSSTX}/g" /etc/svxlink/svxlink.conf

  perl -i -pe "s/--LOCATION--/${LOCATION}/g" /etc/svxlink/node_info.json
  perl -i -pe "s/--LAT--/${LAT}/g" /etc/svxlink/node_info.json
  perl -i -pe "s/--LON--/${LON}/g" /etc/svxlink/node_info.json
  perl -i -pe "s/--LOC--/${LOC}/g" /etc/svxlink/node_info.json
  perl -i -pe "s/--HIDDEN--/false/g" /etc/svxlink/node_info.json

  if [[ "${NEW_HOSTNAME}" != "$(hostname)" ]]; then
    say "Setting hostname to ${NEW_HOSTNAME}"
    run "hostnamectl set-hostname ${NEW_HOSTNAME}"
    # /etc/hosts: keep 127.0.1.1 mapped to the new name so sudo/sshd
    # don't pause on hostname resolution.
    if grep -qE '^127\.0\.1\.1' /etc/hosts; then
      run "sed -i -E 's|^(127\\.0\\.1\\.1)\\s+.*|\\1\\t${NEW_HOSTNAME}|' /etc/hosts"
    else
      run "printf '127.0.1.1\\t%s\\n' '${NEW_HOSTNAME}' >> /etc/hosts"
    fi
  fi

  # DTMF-mode overrides — apply to every chip variant (was PRO-only
  # before). In DTMF mode the sa818 chip handles the whole signal
  # chain in hardware:
  #   - CTCSS decode → drives its SQ pin → wired to GPIO12 (COS input,
  #     see README.md § GPIO Pin Usage). svxlink reads squelch off
  #     GPIO12 via SQL_DET=GPIOD; the CTCSS_* keys get commented so
  #     svxlink doesn't also try to software-decode.
  #   - Emphasis + band-limiting → chip filters (see the filter-enable
  #     block further down which now also fires on SWITCH_MODE=DTMF).
  #     DEEMPHASIS=0/PREEMPHASIS=0 in svxlink so we don't shape twice.
  #
  # No per-tone CTCSS→TG mapping is in effect either, so DEFAULT_TG=0
  # would leave the user parked on nothing and having to dial in on
  # every boot — set it to the first entry of MONITOR_TGS.
  #
  # NOTE: $ (not \s*$) on the SQL_DET rewrite — \s would eat the
  # trailing newline and the inserted block would run straight into
  # the next config line. sed (not tr -d) on the per-line TG strip:
  # tr's [:space:] eats the newlines we just inserted with tr ',' '\n'
  # and collapses everything into one giant fake TG number.
  if [[ "${SWITCH_MODE}" == "DTMF" ]]; then
    say "Applying DTMF-mode overrides to svxlink.conf (chip-driven squelch + emphasis)"
    perl -i -pe 's/^(SQL_DET=CTCSS)$/#$1\nSQL_DET=GPIOD\nSQL_GPIOD_CHIP=gpiochip0\nSQL_GPIOD_LINE=!12/' /etc/svxlink/svxlink.conf
    perl -i -pe 's/^(CTCSS_MODE=.*)$/#$1/'        /etc/svxlink/svxlink.conf
    perl -i -pe 's/^(CTCSS_FQ=.*)$/#$1/'          /etc/svxlink/svxlink.conf
    perl -i -pe 's/^(CTCSS_TO_TG_DELAY=.*)$/#$1/' /etc/svxlink/svxlink.conf
    perl -i -pe 's/^DEEMPHASIS=.*$/DEEMPHASIS=0/'  /etc/svxlink/svxlink.conf
    perl -i -pe 's/^PREEMPHASIS=.*$/PREEMPHASIS=0/' /etc/svxlink/svxlink.conf

    FIRST_TG=$(echo "${TGS}" | tr ',' '\n' | sed 's/[+[:space:]]//g' | grep -E '^[0-9]+$' | head -n1)
    if [[ -n "${FIRST_TG}" ]]; then
      say "Setting DEFAULT_TG=${FIRST_TG} (first monitored TG) — DTMF switching, no per-tone CTCSS mapping"
      perl -i -pe "s/^DEFAULT_TG=.*\$/DEFAULT_TG=${FIRST_TG}/" /etc/svxlink/svxlink.conf
    fi
  fi

  rm -f /usr/sbin/hotspot

  say "Configuring hotspot"
  echo "#!/bin/bash" > /usr/sbin/hotspot
  echo "" >> /usr/sbin/hotspot
  echo "sa818 --port ${SERIAL_PORT} radio --bw 0 --frequency ${FREQ} --ctcss ${CTCSSTX},${CTCSSRX} --squelch 8" >> /usr/sbin/hotspot
  # Chip-side filter emit rules — three cases, in order:
  #
  #   IS_PRO_CHIP=1     — SA818PRO handles emphasis + band-limiting
  #                       internally as a fixed feature and does NOT
  #                       accept the AT+SETFILTER command. Skip the
  #                       filter line entirely. hotspot-frequency also
  #                       preserves the "no filter line" state so
  #                       later frequency changes don't inject one.
  #                       svxlink emphasis stays at 0 (PRO does it in
  #                       hardware) — set by the DTMF apply block.
  #
  #   SWITCH_MODE=DTMF  — SA818/SA868 in DTMF mode. Chip is already
  #                       doing the CTCSS decode + driving GPIO12 for
  #                       squelch, so let it also handle emphasis +
  #                       band-limiting. svxlink stays out of the
  #                       audio path (DEEMPHASIS=0/PREEMPHASIS=0 in
  #                       the DTMF apply block above).
  #
  #   Otherwise          — SA818/SA868 in CTCSS switching mode. svxlink
  #                       does software CTCSS decode AND emphasis
  #                       (template defaults DEEMPHASIS=1 / PREEMPHASIS=1
  #                       stay in place — no override). Chip filters
  #                       off so audio isn't shaped twice. This is
  #                       the case regardless of board generation:
  #                       the previous IS_NEW_BOARD=1 -> enable-anyway
  #                       rule doubled the emphasis on 4th-gen +
  #                       CTCSS-mode boxes and made RX sound
  #                       over-driven ("oversteered") to users.
  if [[ "${IS_PRO_CHIP}" == "1" ]]; then
    say "SA818PRO detected — no chip filters line (chip handles filtering internally)"
  elif [[ "${SWITCH_MODE}" == "DTMF" ]]; then
    echo "sa818 --port ${SERIAL_PORT} filters --emphasis enable --highpass enable --lowpass enable" >> /usr/sbin/hotspot
  else
    echo "sa818 --port ${SERIAL_PORT} filters --emphasis disable --highpass disable --lowpass disable" >> /usr/sbin/hotspot
  fi
  echo "sa818 --port ${SERIAL_PORT} volume --level ${CPVOL}" >> /usr/sbin/hotspot
  chmod +x /usr/sbin/hotspot

  run "/usr/sbin/hotspot"

  say "Configuring hotspot volume (${AUDIO_CODEC})"
  echo "#!/bin/bash" > /usr/sbin/hotspot_volume
  echo "" >> /usr/sbin/hotspot_volume

  if [[ "${AUDIO_CODEC}" == "TLV320AIC3204" ]]; then
    cat <<EOF >> /usr/sbin/hotspot_volume
# TLV320AIC3204 (audiosense-pi overlay) — REV 6+ boards.
# Board audio path (schematic sheet 2):
#   codec LOL (pin 22) -> transformer T1 -> sa818 MIC_IN
#   codec IN1_L (pin 13) <- transformer T2 <- sa818 AF_OUT
# Left channel only; right side is unused on this board.

# Playback (LOL -> sa818 MIC)
amixer -c 0 sset 'PCM' ${AFVOL}%             > /dev/null
amixer -c 0 sset 'LO DAC' on                 > /dev/null
amixer -c 0 sset 'LO Driver Gain' 0dB        > /dev/null
amixer -c 0 sset 'LOL Output Mixer L_DAC' on > /dev/null

# Capture (sa818 AF_OUT -> IN1_L -> PGA -> ADC)
amixer -c 0 sset 'Mic PGA' on                                        > /dev/null
amixer -c 0 sset 'IN1_L to Left Mixer Positive Resistor' '10 kOhm'   > /dev/null
amixer -c 0 sset 'ADCFGA Left Mute' off                              > /dev/null
amixer -c 0 sset 'PGA Level' ${RFVOL}%                               > /dev/null
amixer -c 0 sset 'ADC Level' 80%                                     > /dev/null
EOF
  else
    echo "# audio to radio Module" >> /usr/sbin/hotspot_volume
    echo "amixer set 'Headphone' ${AFVOL}%" >> /usr/sbin/hotspot_volume
    echo "# audio from radio Module" >> /usr/sbin/hotspot_volume
    echo "amixer set 'Capture' ${RFVOL}%" >> /usr/sbin/hotspot_volume
    echo "" >> /usr/sbin/hotspot_volume
    cat <<'EOF' >> /usr/sbin/hotspot_volume
# Disable ALC en Deemphasis
amixer cset iface=MIXER,name='DAC Deemphasis Switch' 0
amixer cset iface=MIXER,name='ALC Function' 0
amixer cset iface=MIXER,name='ALC Target' 0
amixer cset iface=MIXER,name='ALC Mode' 1
amixer cset iface=MIXER,name='ALC Attack' 0
amixer cset iface=MIXER,name='ALC Decay' 0
amixer cset iface=MIXER,name='ALC Hold Time' 0
amixer cset iface=MIXER,name='ALC Max Gain' 0
amixer cset iface=MIXER,name='ALC Min Gain' 0
amixer cset iface=MIXER,name='ADC High Pass Filter Switch' 0
EOF
  fi
  chmod +x /usr/sbin/hotspot_volume

  # Only run the generated volume script if a sound card is already
  # up. On a codec-swap run (audiosense-pi just added, wm8960 just
  # removed) the card won't appear until reboot; leaving hotspot_volume
  # in place is enough — svxlink_checkalsa runs it at next boot.
  if aplay -l 2>/dev/null | grep -qE '^card [0-9]'; then
    run "/usr/sbin/hotspot_volume > /dev/null 2>&1"

    # Interactive RX-gain auto-tune. Prompts the operator to key up
    # and speak; measures the peak; adjusts PGA Level (TLV320) or
    # Capture (WM8960) so the peak lands near -6 dBFS; persists the
    # new value into /usr/sbin/hotspot_volume. Skippable — pressing
    # "Skip" leaves the initial defaults in place. hotspot-tune-volume
    # stops+starts svxlink itself; the restart below then picks up
    # the freshly-generated svxlink.conf.
    if [ -x /usr/sbin/hotspot-tune-volume ]; then
      /usr/sbin/hotspot-tune-volume || true
    fi
  else
    say "No sound card active yet — hotspot_volume will apply on next reboot"
    say "Run 'sudo hotspot-tune-volume' after the reboot to tune RX gain to your HT."
  fi

  systemctl restart svxlink
  systemctl restart fmchip-monitor

  say "Updating Logic.tcl"
  run "wget -O /usr/share/svxlink/events.d/Logic.tcl https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/Logic.tcl > /dev/null 2>&1"

  RELOAD_SYSTEMD=0

  if [ -f /usr/sbin/hotspot-bluetooth ]; then
    say "Updating hotspot-bluetooth"
    run "wget -O /usr/sbin/hotspot-bluetooth https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-bluetooth > /dev/null 2>&1"
    run "chmod +x /usr/sbin/hotspot-bluetooth"
    run "wget -O /etc/systemd/system/hotspot-bluetooth.service https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-bluetooth.service > /dev/null 2>&1"

    # Re-apply the BlueZ tuning that install-bluetooth.sh wrote on first
    # install. All idempotent — running these again on an already-tuned
    # box is a no-op. Keep in sync with install-bluetooth.sh.
    if [[ -f /etc/bluetooth/main.conf ]]; then
      say "Re-applying /etc/bluetooth/main.conf tuning"
      run "sed -i -E 's/^[#[:space:]]*(ControllerMode[[:space:]]*=).*/\1 le/' /etc/bluetooth/main.conf"
      run "sed -i -E 's/^[#[:space:]]*(Experimental[[:space:]]*=).*/\1 true/' /etc/bluetooth/main.conf"
      run "sed -i -E 's/^[#[:space:]]*(FastConnectable[[:space:]]*=).*/\1 false/' /etc/bluetooth/main.conf"
      run "sed -i -E 's/^[#[:space:]]*(MinAdvertisementInterval[[:space:]]*=).*/\1 100/' /etc/bluetooth/main.conf"
      run "sed -i -E 's/^[#[:space:]]*(MaxAdvertisementInterval[[:space:]]*=).*/\1 150/' /etc/bluetooth/main.conf"
      # iOS bond-persistence fix (keep in sync with install-bluetooth.sh):
      # AlwaysPairable=true kills bluetoothd's race that disables Bondable
      # at power-on when no agent is registered yet. Privacy=device makes
      # the kernel LE resolving list actually populate so iOS's rotating
      # RPA resolves against the stored IRK. JustWorksRepairing=always
      # accepts iOS's occasional re-pair attempts silently.
      run "sed -i -E 's/^[#[:space:]]*(AlwaysPairable[[:space:]]*=).*/\1 true/' /etc/bluetooth/main.conf"
      grep -qE '^[[:space:]]*AlwaysPairable[[:space:]]*=' /etc/bluetooth/main.conf \
        || run "printf '\nAlwaysPairable = true\n' >> /etc/bluetooth/main.conf"
      run "sed -i -E 's/^[#[:space:]]*(Privacy[[:space:]]*=).*/\1 device/' /etc/bluetooth/main.conf"
      grep -qE '^[[:space:]]*Privacy[[:space:]]*=' /etc/bluetooth/main.conf \
        || run "printf 'Privacy = device\n' >> /etc/bluetooth/main.conf"
      run "sed -i -E 's|^[#[:space:]]*(JustWorksRepairing[[:space:]]*=).*|\1 always|' /etc/bluetooth/main.conf"
      grep -qE '^[[:space:]]*JustWorksRepairing[[:space:]]*=' /etc/bluetooth/main.conf \
        || run "printf 'JustWorksRepairing = always\n' >> /etc/bluetooth/main.conf"
    fi

    # Ensure the bond store exists with correct perms so bluetoothd can
    # actually write LTKs to it after a successful pair.
    run "install -d -m 0700 -o root -g root /var/lib/bluetooth"

    say "Re-applying bluetoothd drop-in (--experimental + plugin trim + bond store)"
    BTD_PATH=$(awk -F= '/^ExecStart=/{ print $2; exit }' /lib/systemd/system/bluetooth.service 2>/dev/null | awk '{print $1}')
    [[ -z "${BTD_PATH}" ]] && BTD_PATH=/usr/libexec/bluetooth/bluetoothd
    mkdir -p /etc/systemd/system/bluetooth.service.d
    BTD_NOPLUGIN=midi,sap,input,hog,a2dp,avrcp,audio,hsp,hfp,pbap,map,obex,network,health,wiimote
    cat > /etc/systemd/system/bluetooth.service.d/experimental.conf <<EOF
[Service]
ExecStart=
ExecStart=${BTD_PATH} --experimental --noplugin=${BTD_NOPLUGIN}
StateDirectory=bluetooth
ReadWritePaths=-/var/lib/bluetooth
EOF

    RELOAD_SYSTEMD=1
  fi

  if [ -f /usr/sbin/hotspot-4g ]; then
    say "Updating hotspot-4g"
    run "wget -O /usr/sbin/hotspot-4g https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-4g > /dev/null 2>&1"
    run "chmod +x /usr/sbin/hotspot-4g"
    run "wget -O /etc/systemd/system/hotspot-4g.service https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-4g.service > /dev/null 2>&1"
    RELOAD_SYSTEMD=1
  fi

  if [ -f /usr/sbin/hotspot-4g-monitor ]; then
    say "Updating hotspot-4g-monitor"
    run "wget -O /usr/sbin/hotspot-4g-monitor https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-4g-monitor > /dev/null 2>&1"
    run "chmod +x /usr/sbin/hotspot-4g-monitor"
    run "wget -O /etc/systemd/system/hotspot-4g-monitor.service https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-4g-monitor.service > /dev/null 2>&1"
    RELOAD_SYSTEMD=1
  fi

  # wlan-state is the BT-aware wlan0 up/down helper used by the 4G
  # stack. Only relevant if 4G is installed.
  if [ -f /usr/sbin/hotspot-4g ]; then
    say "Updating wlan-state + disable-wlan.service (combo-chip BT fix)"
    run "wget -O /usr/sbin/wlan-state https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/wlan-state > /dev/null 2>&1"
    run "chmod +x /usr/sbin/wlan-state"
    run "wget -O /etc/systemd/system/disable-wlan.service https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/disable-wlan.service > /dev/null 2>&1"
    RELOAD_SYSTEMD=1
  fi

  if [ "$RELOAD_SYSTEMD" = "1" ]; then
    run "systemctl daemon-reload"
  fi

  say "Downloading hotspot-options"
  run "wget -O /usr/sbin/hotspot-options https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-options > /dev/null 2>&1"
  run "chmod +x /usr/sbin/hotspot-options"

  say "Downloading hotspot-volume"
  run "wget -O /usr/sbin/hotspot-volume https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-volume > /dev/null 2>&1"
  run "chmod +x /usr/sbin/hotspot-volume"

  say "Downloading hotspot-frequency"
  run "wget -O /usr/sbin/hotspot-frequency https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-frequency > /dev/null 2>&1"
  run "chmod +x /usr/sbin/hotspot-frequency"

  say "Downloading hotspot-talkgroups"
  # hotspot-talkgroups is chip-aware: on non-PRO it edits both the CTCSS
  # mapping and the monitored-TG list; on PRO it skips the CTCSS prompt,
  # asks only for the monitored TGs, and re-applies the PRO overrides
  # (SQL_DET=GPIOD / DEEMPHASIS=0 / PREEMPHASIS=0) + sets DEFAULT_TG to
  # the first monitored TG. So it's safe to install everywhere.
  run "wget -O /usr/sbin/hotspot-talkgroups https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/hotspot-talkgroups > /dev/null 2>&1"
  run "chmod +x /usr/sbin/hotspot-talkgroups"

  say "Downloading install-4gmodule"
  run "wget -O /usr/sbin/install-4gmodule https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/install-4gmodule > /dev/null 2>&1"
  run "chmod +x /usr/sbin/install-4gmodule"

  say "Downloading install-bluetooth"
  run "wget -O /usr/sbin/install-bluetooth https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/install-bluetooth.sh> /dev/null 2>&1"
  run "chmod +x /usr/sbin/install-bluetooth"

  say "Downloading install-svxlink-watchdog"
  run "wget -O /usr/sbin/install-svxlink-watchdog https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/install-svxlink-watchdog.sh > /dev/null 2>&1"
  run "chmod +x /usr/sbin/install-svxlink-watchdog"

  # svxlink_checkalsa gets pulled in the same block so existing boxes
  # pick up the codec-agnostic wait (drops the WM8960-only card-name
  # grep). Static hotspot_volume is also refreshed for boxes that
  # never re-ran hotspot-config: the codec-detecting fallback in the
  # static copy is what runs at first boot before hotspot-config
  # generates a codec-specific one.
  say "Downloading svxlink_checkalsa"
  run "wget -O /usr/sbin/svxlink_checkalsa https://raw.githubusercontent.com/Guru-RF/Analog-HotSPOT-SVXLink/master/svxlink_checkalsa > /dev/null 2>&1"
  run "chmod +x /usr/sbin/svxlink_checkalsa"

  # hotspot-tune-volume itself is refreshed at the TOP of this script
  # (staged download) — that's early enough for the invocation earlier
  # in the commit block to see the fresh copy on the very first
  # upgrade run.
  say "--> Done"
  say ""
  say "Send any CTCSS tone to ${FREQ} with D1# to activate the parrot (to test audio levels)"
  say "Send CTCSS tone mapped to a channel to switch talkgroup (only when there is no traffic and you are in TG0)"
  say "You here a small two-tone when we are back in listening mode on TG0, when there is traffic on a monitored it will be automaticaly activated !"
  say ""
  say "run [>sudo /usr/sbin/hotspot-volume] to adjust volume levels"
  say "run [>sudo /usr/sbin/hotspot-tune-volume] to auto-tune RX gain to your HT (key up + speak)"
  say "run [>sudo /usr/sbin/hotspot-frequency] to adjust frequency and tx ctcss tone"
  say "run [>sudo /usr/sbin/hotspot-talkgroups] to adjust talkgroups (and the CTCSS mapping on non-PRO chips)"
  say "run [>sudo /usr/sbin/hotspot-on-webportal] to update webportal talkgroups"
  say "run [>sudo /usr/sbin/install-4gmodule] to install 4g support if you have a hotspot-4g"
  say "run [>sudo /usr/sbin/install-bluetooth] to install bluetooth support and use the companion app on your computer / phone (https://svxlink-hotspot.app)"
  say ""
  say "run [>sudo /usr/sbin/hotspot-options] to reduce power consumption and better thermal and other interesting options"
  say ""
  if [[ "${NEW_HOSTNAME}" != "hotspot" ]]; then
    say "After reboot the device advertises as http://${NEW_HOSTNAME}.local (not hotspot.local anymore)"
    say ""
  fi
  say "please reboot your system with:"
  say "run [>sudo reboot]"

  rm -f /needsconfig
else
  gum style --foreground "#04B575" "Abort!"
fi

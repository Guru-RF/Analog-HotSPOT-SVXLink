#!/bin/bash
# /usr/sbin/wlan-state — combo-chip-friendly wlan0 up/down for the 4G stack.
#
# On the BCM combo chips (Pi Zero 2W BCM43430A1 and friends), the BT side
# of the radio refuses to register LE advertisements when wlan0 has been
# ip-link-down'd. That cripples the hotspot-bluetooth GATT server on any
# 4G hotspot where install-bluetooth has also been run.
#
# This helper centralises the up/down decision:
#   - When BT is installed (marker: /usr/sbin/hotspot-bluetooth exists)
#     we KEEP wlan0 up at the netdev layer and only stop user-space
#     AccessPopup so wlan0 isn't broadcasting an AP we don't want. The
#     combo chip stays in a state BT advertising is happy with.
#   - When BT is NOT installed we fall back to the original behaviour
#     (`ip link set wlan0 down`) — frees the radio, saves a little
#     power, lets the user truly disable Wi-Fi while 4G is the uplink.
#
# Consumed by: disable-wlan.service, hotspot-4g (success path),
# hotspot-4g-monitor (bring_wlan_{up,down}).

set -u

action="${1:-}"
BT_INSTALLED=0
[ -f /usr/sbin/hotspot-bluetooth ] && BT_INSTALLED=1

case "$action" in
  down)
    # AccessPopup off either way: don't want it broadcasting an AP while
    # 4G is carrying the traffic. Idempotent; no-op if not a unit.
    systemctl stop accesspopup.service 2>/dev/null || true
    if [ "$BT_INSTALLED" -eq 0 ]; then
      ip link set wlan0 down 2>/dev/null || true
    fi
    # BT_INSTALLED=1 → leave the netdev up; combo chip stays happy.
    ;;
  up)
    # Bring the netdev up (no-op if already up) and try-restart
    # AccessPopup so it re-evaluates against the now-active state.
    # AP fallback comes back automatically when no known Wi-Fi is in
    # range.
    ip link set wlan0 up 2>/dev/null || true
    systemctl try-restart accesspopup.service 2>/dev/null || true
    ;;
  *)
    echo "usage: $0 {up|down}" >&2
    exit 2
    ;;
esac

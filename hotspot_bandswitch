#!/bin/bash
#
# hotspot_bandswitch — historical helper that used to sed
# /usr/sbin/hotspot's --frequency between 434.925 (UHF) and 145.925
# (VHF) based on whatever hotspot-detect saw on the GPIO straps.
#
# The auto-sed was actively harmful:
#   - Fired as ExecStartPre for svxlink.service (see svxlink.service),
#     so every svxlink start / boot silently rewrote the user's
#     configured frequency back to the detected-band default.
#   - A user who deliberately picked VHF on a UHF-detected chip
#     (bench-test / VHF antenna hardware / SA818Pro cross-band setup)
#     would have their 145.925 stomped back to 434.925 within seconds.
#   - Hardcoded 434.925 / 145.925 assumption ignored anything else the
#     user might have programmed (repeater input freq, ISM band, etc.).
#
# Behaviour is now warn-only: it looks up detected band vs configured
# frequency and PRINTS a mismatch to journalctl, but changes nothing.
# The user's configured frequency is authoritative — hotspot-config
# and hotspot-frequency prompt for it, and that's where the source of
# truth lives.
#
# Left as an ExecStartPre entry on svxlink.service so existing installs
# don't need a systemd unit rewrite; the script is now a no-op that
# just logs (harmless overhead per start).

HOTSPOT_FILE="/usr/sbin/hotspot"

if [ ! -f "$HOTSPOT_FILE" ]; then
    exit 0
fi

# Detect the band from GPIO straps (may not match the configured freq
# — that's fine, it's the user's call).
BAND=$( /usr/sbin/hotspot-detect 2>/dev/null | awk -F': ' '/^BAND:/ {print $2}' )
CUR_FREQ=$( grep -m1 'sa818 .* radio' "$HOTSPOT_FILE" | sed -n 's/.*--frequency \([^ ]*\).*/\1/p' )

case "$BAND" in
    VHF)
        # UHF-shaped freq on a VHF-detected chip — inform, don't touch.
        if [[ "$CUR_FREQ" == 4* ]]; then
            echo "hotspot_bandswitch: detected VHF chip but configured freq is ${CUR_FREQ} (UHF). Leaving as-is; run sudo hotspot-frequency to change."
        fi
        ;;
    UHF)
        # VHF-shaped freq on a UHF-detected chip — inform, don't touch.
        if [[ "$CUR_FREQ" == 1* ]]; then
            echo "hotspot_bandswitch: detected UHF chip but configured freq is ${CUR_FREQ} (VHF). Leaving as-is; run sudo hotspot-frequency to change."
        fi
        ;;
esac

exit 0

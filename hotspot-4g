#!/bin/bash
set -uo pipefail  # note: NOT -e, we want to handle failures
CONF="/etc/hotspot-4g.conf"
APN="globaldata.iot"; IP_TYPE="4"; AUTH=""; APN_USER=""; APN_PASS=""
PREFERRED_NETWORKS=""
[[ -f "$CONF" ]] && source "$CONF"

DEV=/dev/cdc-wdm0
IFACE=wwan0
MAX_ATTEMPTS=99

log() { echo "[$(date +%H:%M:%S)] $*"; }

stop_modemmanager() {
  # ModemManager will hold /dev/cdc-wdm0 and make every non-proxied qmicli
  # call return empty. Keep it out of the way for the whole session.
  systemctl stop ModemManager.service 2>/dev/null || true
}

apply_preferred_networks() {
  # When PREFERRED_NETWORKS is set in hotspot-4g.conf, push it into the
  # modem's NV-stored preference list. The modem already keeps the list
  # across reboots — this call just re-asserts it, so a fresh image / a
  # modem factory reset can't silently drop the bias and let the modem
  # start camping on a forbidden roaming partner again. Cheap to run
  # repeatedly (one NV write per script start, modem flash easily takes
  # millions of cycles).
  [[ -z "${PREFERRED_NETWORKS}" ]] && return
  log "Applying PREFERRED_NETWORKS=${PREFERRED_NETWORKS}"
  qmicli -p -d "$DEV" --nas-set-preferred-networks="${PREFERRED_NETWORKS}" \
    >/dev/null 2>&1 \
    || log "WARNING: failed to apply preferred networks (continuing)"
}

cleanup_sessions() {
  # Release any stale WDS clients from a previous run
  qmicli -p -d "$DEV" --wds-reset 2>/dev/null || true
  qmicli -p -d "$DEV" --wds-stop-network=disable-autoconnect 2>/dev/null || true
  pkill -f "udhcpc.*$IFACE" 2>/dev/null || true
  ip addr flush dev "$IFACE" 2>/dev/null || true
  ip link set "$IFACE" down 2>/dev/null || true
}

wait_for_device() {
  for _ in $(seq 1 60); do
    [[ -c "$DEV" ]] && return 0
    sleep 1
  done
  return 1
}

wait_for_registration() {
  local out err last_err=""
  for i in $(seq 1 60); do
    err=$(mktemp)
    out=$(qmicli -p -d "$DEV" --nas-get-serving-system 2>"$err" || true)
    if echo "$out" | grep -qE "Registration state: 'registered'"; then
      rm -f "$err"
      return 0
    fi
    if [[ -z "$out" ]]; then
      last_err=$(<"$err")
      if (( i % 10 == 0 )) && [[ -n "$last_err" ]]; then
        log "qmicli nas-get-serving-system: ${last_err//$'\n'/ | }"
      fi
    fi
    rm -f "$err"
    sleep 2
  done
  [[ -n "$last_err" ]] && log "last qmicli error: ${last_err//$'\n'/ | }"
  return 1
}

reset_modem() {
  log "Resetting modem via QMI..."
  qmicli -p -d "$DEV" --dms-set-operating-mode=low-power 2>/dev/null || true
  sleep 3
  qmicli -p -d "$DEV" --dms-set-operating-mode=online 2>/dev/null || true
  sleep 5
}

start_session() {
  local wds="apn='${APN}',ip-type=${IP_TYPE}"
  [[ -n "$AUTH" ]]     && wds+=",auth=${AUTH}"
  [[ -n "$APN_USER" ]] && wds+=",username='${APN_USER}'"
  [[ -n "$APN_PASS" ]] && wds+=",password='${APN_PASS}'"

  qmicli -p -d "$DEV" \
    --device-open-net='net-raw-ip|net-no-qos-header' \
    --wds-start-network="$wds" \
    --client-no-release-cid
}

get_ip() {
  # Retry DHCP a few times; first attach is often slow
  for _ in 1 2 3; do
    if udhcpc -q -t 6 -T 3 -n -i "$IFACE"; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# --- main ---
stop_modemmanager

for attempt in $(seq 1 $MAX_ATTEMPTS); do
  log "Attempt $attempt/$MAX_ATTEMPTS"

  cleanup_sessions
  wait_for_device || { log "no $DEV"; reset_modem; continue; }

  # Push PREFERRED_NETWORKS to NV once we know the device exists. Only
  # runs on the first attempt — re-asserting it every retry would slow
  # the recovery loop down for no benefit.
  (( attempt == 1 )) && apply_preferred_networks

  echo Y > /sys/class/net/$IFACE/qmi/raw_ip
  ip link set "$IFACE" up

  if ! wait_for_registration; then
    log "not registered"
    [[ $attempt -ge 2 ]] && reset_modem
    continue
  fi

  if ! start_session; then
    log "wds-start-network failed"
    [[ $attempt -ge 2 ]] && reset_modem
    continue
  fi

  if get_ip; then
    log "online"
    /usr/sbin/hotspot_dtmf "D912#"
    if ip link show wlan0 >/dev/null 2>&1; then
      log "disabling wlan0 until next reboot"
      ip link set wlan0 down 2>/dev/null || true
    fi
    exit 0
  fi
  log "dhcp failed"
done

log "giving up after $MAX_ATTEMPTS attempts"
exit 1
